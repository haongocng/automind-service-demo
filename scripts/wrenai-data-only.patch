+import { presentReport } from './presentation';
+import { visualIssue } from './visual';
+import { AnalysisReport, ReportVisual } from './types';
+
+test('saved evidence stays immutable while implementation notes and SQL are removed from display', () => {
+  const report = {
+    task: 'exploration',
+    scope: { ref: { viewId: 'sales' } },
+    summary: [
+      'Item sales = SUM(item_price); Orders = COUNT(DISTINCT order_id).',
+    ],
+    findings: [
+      {
+        id: 'sales',
+        title: 'Sales',
+        interpretation: 'Observed sales: 120.',
+        evidenceIds: ['sales'],
+      },
+    ],
+    visuals: [
+      {
+        id: 'sales',
+        caption: 'sum(item_price) grouped by month',
+        chartSpec: { data: { values: [{ value: 120 }] } },
+      },
+    ],
+    limitations: [
+      'This descriptive analysis computes real SQL aggregates and rule-based explanations. The goal does not invoke an LLM or arbitrary new analysis.',
+    ],
+  } as unknown as AnalysisReport;
+  const before = JSON.stringify(report);
+  const display = presentReport(report);
+  expect(JSON.stringify(report)).toBe(before);
+  expect(display.visuals[0].chartSpec).toBe(report.visuals[0].chartSpec);
+  expect(display.insights[0].detail).toContain('120');
+  expect(
+    JSON.stringify([
+      display.summary,
+      display.limitations,
+      display.visuals[0].caption,
+    ]),
+  ).not.toMatch(/SUM\(|COUNT\(|LLM|rule-based/i);
+  expect(display.limitations.join(' ')).toContain('freight');
+});
+
+test('boxplots accept inline values but cannot fetch data or inject expressions', () => {
+  const visual: ReportVisual = {
+    id: 'spread',
+    title: 'Spread',
+    kind: 'chartSpec',
+    caption: 'Original units',
+    altText: 'Spread',
+    chartSpec: {
+      data: { values: [{ group: 'A', value: 10 }] },
+      mark: { type: 'boxplot', extent: 1.5 },
+      encoding: { x: { field: 'group' }, y: { field: 'value' } },
+    },
+  };
+  expect(visualIssue(visual)).toBeUndefined();
+  expect(
+    visualIssue({
+      ...visual,
+      chartSpec: {
+        ...visual.chartSpec,
+        data: { values: [], url: 'https://example.com/data' },
+      },
+    }),
+  ).toBeDefined();
+  expect(
+    visualIssue({
+      ...visual,
+      chartSpec: {
+        ...visual.chartSpec,
+        encoding: { y: { field: 'value', scale: { domain: { expr: '1+1' } } } },
+      },
+    }),
+  ).toBeDefined();
+});
