+          <div className="footer">
+            {issue ? (
+              <div role="status" style={{ color: '#5c6d94', fontSize: 12 }}>
+                {!draft.target && isSupervised && (
+                  <div style={{ color: '#b42318' }}>
+                    * Required before running
+                  </div>
+                )}
+                {issue}
+              </div>
+            ) : (
+              <Alert
+                type="info"
+                showIcon
+                message="Your current data is ready. Run this analysis without uploading another file."
+              />
+            )}
+            <div className="actions">
+              <Button onClick={back}>Cancel</Button>
+              <Button
+                type="primary"
+                disabled={!!issue || running}
+                loading={running}
+                onClick={run}
+              >
+                Run analysis
+              </Button>
+            </div>
+          </div>
+        </section>
+        <aside className="card setup-context">
+          <h2>{isSupervised ? 'Analysis context' : 'Current data context'}</h2>
+          {[
+            ['Task', taskNames[task]],
+            ['Dataset', ctx.datasetName],
+            ['Data view', ctx.viewName],
+            ['Each row represents', ctx.rowGrain],
+            ...(isSupervised
+              ? [
+                  [
+                    'Evaluation',
+                    draft.evaluation === 'automatic'
+                      ? 'Automatic split'
+                      : 'Separate datasets',
+                  ],
+                  ['Target', draft.target || 'Not selected'],
+                  [
+                    'Features',
+                    draft.featureMode === 'auto'
+                      ? 'Auto-select'
+                      : `${draft.features.length} selected`,
+                  ],
+                ]
+              : []),
+          ].map(([name, value]) => (
+            <div className="context-row" key={name}>
+              <span>{name}</span>
+              <span>{value}</span>
+            </div>
+          ))}
+          <div className="context-next">
+            <h3>{issue ? 'Your next step' : 'What happens next'}</h3>
+            <p className="muted">
+              <BulbOutlined style={{ color: '#164dff', marginRight: 8 }} />
+              {issue ||
+                'AutoMind analyzes the selected scope and builds a report with charts and explanations.'}
+            </p>
+            <h3>Optional changes</h3>
+            <p className="muted">
+              Change the dataset, features, evaluation setup or analysis goal.
+            </p>
+            {isSupervised && (
+              <Alert
+                type="info"
+                showIcon
+                message="A separate test file is only needed when you choose Use separate datasets."
+              />
+            )}
+          </div>
+        </aside>
+      </div>
+    </AnalysisPage>
+  );
+}
+export default function AnalysisSetupPage() {
+  const router = useRouter();
+  const resource = useExplorerResource<SetupData>(
+    {
+      action: 'analysis.setup',
+      ref: { datasetId: router.query.dataset, viewId: router.query.view },
+      fromRun: router.query.fromRun,
+    },
+    0,
+    router.isReady,
+  );
+  return (
+    <ExplorerLayout>
+      {resource.error ? (
+        <AnalysisPage>
+          <h1>Analysis setup</h1>
+          <QueryError error={resource.error} retry={resource.retry} />
+          <Button
+            style={{ marginTop: 16 }}
+            onClick={() => router.push('/home/datasets')}
+          >
+            Back to datasets
+          </Button>
+        </AnalysisPage>
+      ) : resource.data ? (
+        <Setup
+          key={`${resource.data.context.projectId}:${resource.data.context.datasetId}:${resource.data.context.viewId}:${resource.data.context.schemaVersion}:${router.query.fromRun || ''}`}
+          data={resource.data}
+        />
+      ) : (
+        <AnalysisPage>
+          <h1>Analysis setup</h1>
+          <Skeleton active paragraph={{ rows: 12 }} />
+        </AnalysisPage>
+      )}
+    </ExplorerLayout>
+  );
+}
diff --git a/wren-ui/src/pages/home/chat.tsx b/wren-ui/src/pages/home/chat.tsx
new file mode 100644
index 00000000..01f90ae0
--- /dev/null
+++ b/wren-ui/src/pages/home/chat.tsx
@@ -0,0 +1,192 @@
+import { ComponentRef, useMemo, useRef } from 'react';
+import { useRouter } from 'next/router';
+import { Button, message, Typography } from 'antd';
+import { Alert } from 'antd';
+import Settings from '@/components/settings';
+import useModalAction from '@/hooks/useModalAction';
+import ExplorerLayout from '@/components/explorer/ExplorerLayout';
+import useGlobalConfig from '@/hooks/useGlobalConfig';
+import { Logo } from '@/components/Logo';
+import { Path } from '@/utils/enum';
+import Prompt from '@/components/pages/home/prompt';
+import DemoPrompt from '@/components/pages/home/prompt/DemoPrompt';
+import useHomeSidebar from '@/hooks/useHomeSidebar';
+import useAskPrompt from '@/hooks/useAskPrompt';
+import useRecommendedQuestionsInstruction from '@/hooks/useRecommendedQuestionsInstruction';
+import RecommendedQuestionsPrompt from '@/components/pages/home/prompt/RecommendedQuestionsPrompt';
+import {
+  useSuggestedQuestionsQuery,
+  useCreateThreadMutation,
+  useThreadLazyQuery,
+} from '@/apollo/client/graphql/home.generated';
+import { useGetSettingsQuery } from '@/apollo/client/graphql/settings.generated';
+import { CreateThreadInput } from '@/apollo/client/graphql/__types__';
+
+const { Text } = Typography;
+function ChatSetupNotice() {
+  const { config } = useGlobalConfig();
+  const settings = useModalAction();
+  return config?.dataOnlyMode ? (
+    <>
+      <Alert
+        type="info"
+        style={{ margin: 24 }}
+        message="Configure your AI provider to use Data chat."
+        description={
+          <Button type="link" onClick={() => settings.openModal()}>
+            Open Settings
+          </Button>
+        }
+      />
+      <Settings {...settings.state} onClose={settings.closeModal} />
+    </>
+  ) : null;
+}
+
+const Wrapper = ({ children }) => {
+  return (
+    <div
+      className="d-flex align-center justify-center flex-column"
+      style={{ height: '100%' }}
+    >
+      <Logo size={48} color="var(--gray-8)" />
+      <div className="text-md text-medium gray-8 mt-3">
+        Know more about your data
+      </div>
+      {children}
+    </div>
+  );
+};
+
+const SampleQuestionsInstruction = (props) => {
+  const { sampleQuestions, onSelect } = props;
+
+  return (
+    <Wrapper>
+      <ChatSetupNotice />
+      <DemoPrompt demo={sampleQuestions} onSelect={onSelect} />
+    </Wrapper>
+  );
+};
+
+function RecommendedQuestionsInstruction(props) {
+  const { onSelect, loading } = props;
+
+  const {
+    buttonProps,
+    generating,
+    recommendedQuestions,
+    showRetry,
+    showRecommendedQuestionsPromptMode,
+  } = useRecommendedQuestionsInstruction();
+
+  return showRecommendedQuestionsPromptMode ? (
+    <div
+      className="d-flex align-center flex-column pt-10"
+      style={{ margin: 'auto' }}
+    >
+      <RecommendedQuestionsPrompt
+        recommendedQuestions={recommendedQuestions}
+        onSelect={onSelect}
+        loading={loading}
+      />
+      <div className="py-12" />
+    </div>
+  ) : (
+    <Wrapper>
+      <Button className="mt-6" {...buttonProps} />
+      {generating && (
+        <Text className="mt-3 text-sm gray-6">
+          Thinking of good questions for you... (about 1 minute)
+        </Text>
+      )}
+      {!generating && showRetry && (
+        <Text className="mt-3 text-sm gray-6 text-center">
+          We couldn't think of questions right now.
+          <br />
+          Let's try again later.
+        </Text>
+      )}
+    </Wrapper>
+  );
+}
+
+export default function Home() {
+  const { config } = useGlobalConfig();
+  const dataOnlyMode = config?.dataOnlyMode;
+  const $prompt = useRef<ComponentRef<typeof Prompt>>(null);
+  const router = useRouter();
+  const homeSidebar = useHomeSidebar();
+  const askPrompt = useAskPrompt();
+
+  const { data: suggestedQuestionsData } = useSuggestedQuestionsQuery({
+    fetchPolicy: 'cache-and-network',
+  });
+  const [createThread, { loading: threadCreating }] = useCreateThreadMutation({
+    onError: (error) => console.error(error),
+    onCompleted: () => homeSidebar.refetch(),
+  });
+  const [preloadThread] = useThreadLazyQuery({
+    fetchPolicy: 'cache-and-network',
+  });
+
+  const { data: settingsResult } = useGetSettingsQuery();
+  const settings = settingsResult?.settings;
+  const isSampleDataset = useMemo(
+    () => Boolean(settings?.dataSource?.sampleDataset),
+    [settings],
+  );
+
+  const sampleQuestions = useMemo(
+    () => suggestedQuestionsData?.suggestedQuestions.questions || [],
+    [suggestedQuestionsData],
+  );
+
+  const onSelectQuestion = async ({ question }) => {
+    if (dataOnlyMode) {
+      message.info(
+        'AI chat requires a configured AI service and LLM provider.',
+      );
+      return;
+    }
+    $prompt.current.submit(question);
+  };
+
+  const onCreateResponse = async (payload: CreateThreadInput) => {
+    if (dataOnlyMode) return;
+    try {
+      askPrompt.onStopPolling();
+      const response = await createThread({ variables: { data: payload } });
+      const threadId = response.data.createThread.id;
+      await preloadThread({ variables: { threadId } });
+      router.push(Path.Home + `/${threadId}`);
+    } catch (error) {
+      console.error(error);
+    }
+  };
+
+  return (
+    <ExplorerLayout>
+      {!isSampleDataset && <ChatSetupNotice />}
+      {isSampleDataset && (
+        <SampleQuestionsInstruction
+          sampleQuestions={sampleQuestions}
+          onSelect={onSelectQuestion}
+        />
+      )}
+
+      {!isSampleDataset && !dataOnlyMode && (
+        <RecommendedQuestionsInstruction
+          onSelect={onCreateResponse}
+          loading={threadCreating}
+        />
+      )}
+      <Prompt
+        ref={$prompt}
+        {...askPrompt}
+        disabled={dataOnlyMode}
+        onCreateResponse={onCreateResponse}
+      />
+    </ExplorerLayout>
+  );
+}
diff --git a/wren-ui/src/pages/home/datasets.tsx b/wren-ui/src/pages/home/datasets.tsx
new file mode 100644
index 00000000..f74d1bd0
--- /dev/null
+++ b/wren-ui/src/pages/home/datasets.tsx
@@ -0,0 +1,192 @@
+import { useEffect, useState } from 'react';
+import { useRouter } from 'next/router';
+import { Alert, Button, Input, Select, Skeleton } from 'antd';
+import DatabaseOutlined from '@ant-design/icons/DatabaseOutlined';
+import UploadOutlined from '@ant-design/icons/UploadOutlined';
+import ExplorerLayout from '@/components/explorer/ExplorerLayout';
+import { ExplorerWorkspace } from '@/components/explorer/ExplorerStyles';
+
+export default function DatasetsPage() {
+  const router = useRouter();
+  const [catalog, setCatalog] = useState<{
+    canImportCsv: boolean;
+    datasets: {
+      id: string;
+      name: string;
+      kind: string;
+      modelCount: number;
+      views?: { id: string; name: string }[];
+    }[];
+  }>();
+  const [error, setError] = useState<string>();
+  const [name, setName] = useState('');
+  const [grain, setGrain] = useState('');
+  const [file, setFile] = useState<File>();
+  const [loading, setLoading] = useState(false);
+  useEffect(() => {
+    let current = true;
+    fetch('/api/explorer')
+      .then((r) => r.json())
+      .then((d) => {
+        if (current) {
+          if (d.error) setError(d.error);
+          else setCatalog(d);
+        }
+      })
+      .catch((e) => {
+        if (current) setError(e.message);
+      });
+    return () => {
+      current = false;
+    };
+  }, []);
+  const upload = async () => {
+    setLoading(true);
+    setError(undefined);
+    try {
+      const response = await fetch(
+        `/api/explorer/import?name=${encodeURIComponent(name)}&grain=${encodeURIComponent(grain)}`,
+        { method: 'POST', headers: { 'Content-Type': 'text/csv' }, body: file },
+      );
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error);
+      await router.push({
+        pathname: '/home',
+        query: { dataset: result.datasetId, view: result.viewId },
+      });
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setLoading(false);
+    }
+  };
+  return (
+    <ExplorerLayout>
+      <ExplorerWorkspace>
+        <main className="explorer-main">
+          <h1>Your datasets</h1>
+          <p className="explorer-muted">
+            Choose connected data or import a CSV to explore it immediately.
+            Your current connection and models are preserved.
+          </p>
+          {error && (
+            <Alert
+              type="error"
+              showIcon
+              message={error}
+              style={{ marginTop: 20 }}
+            />
+          )}
+          {!catalog ? (
+            !error && <Skeleton active />
+          ) : (
+            <>
+              <div className="selector-grid">
+                {catalog.datasets.map((d) => (
+                  <section className="explorer-card selector-card" key={d.id}>
+                    <DatabaseOutlined
+                      style={{ fontSize: 28, color: '#164dff' }}
+                    />
+                    <h3>{d.name}</h3>
+                    <p className="explorer-muted">
+                      {d.kind}
+                      {d.kind === 'Connected source'
+                        ? ` · ${d.modelCount} models`
+                        : ''}
+                    </p>
+                    <Button
+                      type="primary"
+                      onClick={() =>
+                        router.push({
+                          pathname: '/home',
+                          query: { dataset: d.id },
+                        })
+                      }
+                    >
+                      Explore data
+                    </Button>
+                    {d.views?.length > 0 && (
+                      <label
+                        className="explorer-field"
+                        style={{ marginTop: 16, marginBottom: 0 }}
+                      >
+                        Or explore an individual model
+                        <Select
+                          placeholder="Choose a model"
+                          value={undefined}
+                          onChange={(view) =>
+                            router.push({
+                              pathname: '/home',
+                              query: { dataset: d.id, view },
+                            })
+                          }
+                          options={d.views.map((v) => ({
+                            value: v.id,
+                            label: v.name,
+                          }))}
+                        />
+                      </label>
+                    )}
+                  </section>
+                ))}
+              </div>
+              {catalog.canImportCsv && (
+                <section className="explorer-card" style={{ maxWidth: 640 }}>
+                  <h3>
+                    <UploadOutlined /> Import CSV
+                  </h3>
+                  <p className="explorer-muted">
+                    Import a local data view. Date fields and business
+                    definitions are optional.
+                  </p>
+                  <label className="explorer-field">
+                    CSV file
+                    <input
+                      type="file"
+                      accept=".csv,text/csv"
+                      onChange={(e) => {
+                        const f = e.target.files?.[0];
+                        setFile(f);
+                        if (f) setName(f.name.replace(/\.csv$/i, ''));
+                      }}
+                    />
+                  </label>
+                  <label className="explorer-field">
+                    Dataset name
+                    <Input
+                      value={name}
+                      maxLength={120}
+                      onChange={(e) => setName(e.target.value)}
+                    />
+                  </label>
+                  <label className="explorer-field">
+                    Each row represents (optional)
+                    <Input
+                      value={grain}
+                      maxLength={150}
+                      placeholder="Not defined"
+                      onChange={(e) => setGrain(e.target.value)}
+                    />
+                  </label>
+                  <Button
+                    type="primary"
+                    loading={loading}
+                    disabled={!file || !name.trim()}
+                    onClick={upload}
+                  >
+                    Import and explore
+                  </Button>
+                </section>
+              )}
+              <p className="explorer-muted" style={{ marginTop: 20 }}>
+                This WrenAI project has one connected source. Individual models
+                and imported CSV views can be explored separately. Manage the
+                source in Settings.
+              </p>
+            </>
+          )}
+        </main>
+      </ExplorerWorkspace>
+    </ExplorerLayout>
+  );
+}
diff --git a/wren-ui/src/pages/home/report.tsx b/wren-ui/src/pages/home/report.tsx
new file mode 100644
index 00000000..b2095a41
--- /dev/null
+++ b/wren-ui/src/pages/home/report.tsx
@@ -0,0 +1,326 @@
+import { useEffect } from 'react';
+import { useRouter } from 'next/router';
+import { Alert, Button, Skeleton, Tag } from 'antd';
+import ArrowLeftOutlined from '@ant-design/icons/ArrowLeftOutlined';
+import ExplorerLayout from '@/components/explorer/ExplorerLayout';
+import { AnalysisPage } from '@/components/analysis/AnalysisStyles';
+import ReportVisual from '@/components/analysis/ReportVisual';
+import { QueryError } from '@/components/explorer/ExplorerChart';
+import { useExplorerResource } from '@/components/explorer/api';
+import { RunRecord } from '@/utils/analysis/types';
+import { taskNames } from '@/utils/analysis/config';
+import { presentReport } from '@/utils/analysis/presentation';
+
+export default function AnalysisReportPage() {
+  const router = useRouter();
+  const resource = useExplorerResource<RunRecord>(
+    { action: 'analysis.record', id: router.query.id },
+    0,
+    router.isReady && !!router.query.id,
+  );
+  useEffect(() => {
+    if (resource.data?.status !== 'running') return;
+    const timer = setTimeout(resource.retry, 3000);
+    return () => clearTimeout(timer);
+  }, [resource.data]);
+  const record = resource.data;
+  const report = record?.report ? presentReport(record.report) : undefined;
+  return (
+    <ExplorerLayout>
+      <AnalysisPage>
+        {resource.error ? (
+          <>
+            <h1>Analysis report</h1>
+            <QueryError error={resource.error} retry={resource.retry} />
+          </>
+        ) : !report ? (
+          <>
+            <h1>Analysis report</h1>
+            <Skeleton active paragraph={{ rows: 12 }} />
+          </>
+        ) : (
+          <>
+            <div className="topline">
+              <Button
+                icon={<ArrowLeftOutlined />}
+                onClick={() =>
+                  router.push({
+                    pathname: '/home',
+                    query: {
+                      dataset: report.scope.ref.datasetId,
+                      view: report.scope.ref.viewId,
+                    },
+                  })
+                }
+              >
+                Back to exploration
+              </Button>
+              <Button
+                onClick={() =>
+                  router.push({
+                    pathname: '/home/analysis',
+                    query: { fromRun: report.runId },
+                  })
+                }
+              >
+                Run new analysis
+              </Button>
+            </div>
+            <div className="heading">
+              <h1>Analysis report</h1>
+              <Tag
+                color={
+                  report.status === 'completed'
+                    ? 'green'
+                    : report.status === 'failed'
+                      ? 'red'
+                      : 'blue'
+                }
+              >
+                {report.status === 'completed'
+                  ? 'Completed'
+                  : report.status === 'failed'
+                    ? 'Failed'
+                    : 'Running'}
+              </Tag>
+            </div>
+            <p className="muted">
+              {taskNames[report.task]} · {report.context.datasetName} /{' '}
+              {report.context.viewName} ·{' '}
+              {new Date(report.createdAt).toLocaleString()}
+            </p>
+            <p className="scope">
+              <strong>Scope:</strong>{' '}
+              {report.scope.rowCount
+                ? `${report.scope.rowCount.toLocaleString()} rows · `
+                : ''}
+              {report.scope.rowGrain} ·{' '}
+              {Object.entries(report.scope.filters.values || {})
+                .map(([k, v]) => `${k}: ${v}`)
+                .join(' · ') || 'All values'}
+              {report.scope.filters.from || report.scope.filters.to
+                ? ` · ${report.scope.filters.from || 'Start'} – ${report.scope.filters.to || 'End'}`
+                : ' · All dates'}
+              <br />
+              {report.goal}
+            </p>
+            {report.status === 'failed' ? (
+              <Alert
+                type="error"
+                showIcon
+                message="Analysis failed"
+                description={report.error}
+                action={
+                  <Button
+                    onClick={() =>
+                      router.push({
+                        pathname: '/home/analysis',
+                        query: { fromRun: report.runId },
+                      })
+                    }
+                  >
+                    Review settings
+                  </Button>
+                }
+              />
+            ) : report.status === 'running' ? (
+              <Alert
+                type="info"
+                showIcon
+                message={record.stage || 'Analysis is running'}
+                description="This page follows the saved run’s real status."
+              />
+            ) : (
+              <>
+                <section className="card report-summary">
+                  <h2>Summary</h2>
+                  {report.summary.map((s, i) => (
+                    <p
+                      key={i}
+                      style={{
+                        marginBottom: i === report.summary.length - 1 ? 0 : 8,
+                      }}
+                    >
+                      {s}
+                    </p>
+                  ))}
+                </section>
+                {!!report.insights?.length && (
+                  <section
+                    className="key-insights"
+                    aria-labelledby="key-insights-title"
+                  >
+                    <h2 id="key-insights-title">Key insights</h2>
+                    <p className="muted">
+                      What stands out in the selected data, and how to interpret
+                      it.
+                    </p>
+                    <div className="insights-grid">
+                      {report.insights.map((item) => {
+                        const finding = report.findings.find((f) =>
+                          f.evidenceIds.some((id) =>
+                            item.evidenceIds.includes(id),
+                          ),
+                        );
+                        const visual = report.visuals.find((v) =>
+                          item.evidenceIds.includes(v.id),
+                        );
+                        return (
+                          <article className="card insight-card" key={item.id}>
+                            <h3>{item.title}</h3>
+                            <p>{item.detail}</p>
+                            {(finding || visual) && (
+                              <a
+                                href={`#${finding ? `finding-${finding.id}` : `visual-${visual.id}`}`}
+                              >
+                                View supporting evidence →
+                              </a>
+                            )}
+                          </article>
+                        );
+                      })}
+                    </div>
+                  </section>
+                )}
+                {report.metrics.length > 0 && (
+                  <div className="report-metrics">
+                    {report.metrics.map((m) => (
+                      <div className="card" key={m.label}>
+                        <div className="muted">{m.label}</div>
+                        <div className="metric-value">
+                          {m.value === null
+                            ? 'Not available'
+                            : typeof m.value === 'number'
+                              ? ['Accuracy', 'Macro F1'].includes(m.label)
+                                ? m.value.toLocaleString(undefined, {
+                                    style: 'percent',
+                                    maximumFractionDigits: 1,
+                                  })
+                                : m.value.toLocaleString(undefined, {
+                                    maximumFractionDigits: Number.isInteger(
+                                      m.value,
+                                    )
+                                      ? 0
+                                      : 3,
+                                  })
+                              : m.value}
+                        </div>
+                      </div>
+                    ))}
+                  </div>
+                )}
+                {report.findings.map((f) => (
+                  <section
+                    key={f.id}
+                    id={`finding-${f.id}`}
+                    className="card finding"
+                  >
+                    <div>
+                      {f.evidenceIds.length ? (
+                        f.evidenceIds.map((id) => {
+                          const v = report.visuals.find(
+                            (item) => item.id === id,
+                          );
+                          return v ? (
+                            <ReportVisual key={id} visual={v} />
+                          ) : (
+                            <Alert
+                              key={id}
+                              type="warning"
+                              message="Visual artifact is missing"
+                              action={
+                                <Button size="small" onClick={resource.retry}>
+                                  Retry visual
+                                </Button>
+                              }
+                            />
+                          );
+                        })
+                      ) : (
+                        <p className="muted">
+                          No visual evidence was produced for this finding.
+                        </p>
+                      )}
+                    </div>
+                    <div className="finding-interpretation">
+                      <h2>{f.title}</h2>
+                      <p>{f.interpretation}</p>
+                    </div>
+                  </section>
+                ))}
+                {report.visuals
+                  .filter(
+                    (v) =>
+                      !report.findings.some((f) =>
+                        f.evidenceIds.includes(v.id),
+                      ),
+                  )
+                  .map((v) => (
+                    <section
+                      className="card finding"
+                      key={v.id}
+                      id={`visual-${v.id}`}
+                    >
+                      <ReportVisual visual={v} />
+                      <div className="finding-interpretation">
+                        <h2>{v.title}</h2>
+                        <p>{v.caption}</p>
+                      </div>
+                    </section>
+                  ))}
+                {report.evaluation && (
+                  <section className="card">
+                    <h2>Evaluation used</h2>
+                    <p>
+                      {report.evaluation.finalEvaluation ||
+                        report.evaluation.method}{' '}
+                      ·{' '}
+                      {report.evaluation.strategy
+                        ? `${report.evaluation.strategy} strategy · `
+                        : ''}
+                      {report.evaluation.trainRows
+                        ? `${report.evaluation.trainRows.toLocaleString()} training rows · ${report.evaluation.testRows.toLocaleString()} test rows · ${report.evaluation.selectionFolds} training selection folds`
+                        : `${report.scope.rowCount.toLocaleString()} rows`}
+                    </p>
+                    <details className="muted">
+                      <summary>Characteristics used in this analysis</summary>
+                      {report.evaluation.features?.join(', ') ||
+                        'Not available'}
+                    </details>
+                    {report.scope.test && (
+                      <p className="muted">
+                        Separate test scope: {report.scope.test.ref.datasetId} /{' '}
+                        {report.scope.test.ref.viewId} ·{' '}
+                        {Object.entries(report.scope.test.filters.values || {})
+                          .map(([k, v]) => `${k}: ${v}`)
+                          .join(' · ') || 'All values'}
+                      </p>
+                    )}
+                  </section>
+                )}
+                <div className="report-bottom">
+                  <section className="card">
+                    <h2>Next steps</h2>
+                    <ul>
+                      {report.nextSteps.map((s, i) => (
+                        <li key={i}>{s}</li>
+                      ))}
+                    </ul>
+                  </section>
+                  <section className="card">
+                    <h2>Limitations</h2>
+                    <ul>
+                      {report.limitations.map((s, i) => (
+                        <li key={i}>{s}</li>
+                      ))}
+                    </ul>
+                  </section>
+                </div>
+              </>
+            )}
+          </>
+        )}
+      </AnalysisPage>
+    </ExplorerLayout>
+  );
+}
