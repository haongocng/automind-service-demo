+import { Alert } from 'antd';
+import useGlobalConfig from '@/hooks/useGlobalConfig';
+
+export default function DataModeNotice({
+  description = 'You can browse saved knowledge and open its forms. Saving changes and generating questions require a configured AI service.',
+}: {
+  description?: string;
+}) {
+  const { config } = useGlobalConfig();
+  if (!config?.dataOnlyMode) return null;
+
+  return (
+    <Alert
+      className="my-4"
+      style={{ maxWidth: 800 }}
+      type="info"
+      showIcon
+      message="AI provider not configured"
+      description={description}
+    />
+  );
+}
