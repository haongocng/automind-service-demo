+import { createHash, randomUUID } from 'node:crypto';
+import { components, serverConfig } from '@/common';
+import { LocalDuckdbAdaptor } from '../adaptors/localDuckdbAdaptor';
+import { Manifest } from '../mdl/type';
+import { PreviewDataResponse } from './queryService';
+import {
+  ChartDefinition,
+  ChartResult,
+  ExplorerContext,
+  ExplorerField,
+  ExplorerFilters,
+  ExplorerProfile,
+  ExplorerRef,
+} from '@/utils/explorer/types';
+import {
+  chartSQL,
+  fieldRole,
+  fillTimeGaps,
+  filteredSQL,
+  humanize,
+  metricLabel,
+  quoteId as q,
+  validateChart,
+  validateFilters,
+} from '@/utils/explorer/query';
+
+export const hash = (value: unknown) =>
+  createHash('sha256').update(JSON.stringify(value)).digest('hex');
+const properties = (s: string) => {
+  try {
+    return JSON.parse(s || '{}');
+  } catch {
+    return {};
+  }
+};
+type View = {
+  id: string;
+  name: string;
+  sql: string;
+  fields: ExplorerField[];
+  rowGrain: string;
+  sourceModelIds: number[];
+  sourceNames: string[];
+  sales?: boolean;
+  keyQueries?: string[];
+};
+
+export class ExplorerService {
+  async project(projectId?: number) {
+    const project = await components.projectService.getCurrentProject();
+    if (!project || (projectId !== undefined && project.id !== projectId))
+      throw new Error('Dataset is not accessible in the current project');
+    return project;
+  }
+
+  async catalog() {
+    const project = await this.project();
+    const models = await components.modelRepository.findAllBy({
+      projectId: project.id,
+    });
+    const uploads = serverConfig.dataOnlyMode
+      ? await components
+          .knex('explorer_dataset')
+          .where({ project_id: project.id })
+          .orderBy('created_at', 'desc')
+      : [];
+    return {
+      projectId: project.id,
+      canImportCsv: serverConfig.dataOnlyMode,
+      datasets: [
+        {
+          id: `project:${project.id}`,
+          name:
+            project.sampleDataset === 'ECOMMERCE'
+              ? 'WrenAI E-commerce'
+              : project.displayName || 'Connected data',
+          modelCount: models.length,
+          kind: 'Connected source',
+          views: models.map((m) => ({
+            id: `model:${m.id}`,
+            name: m.displayName || m.referenceName,
+          })),
+        },
+        ...uploads.map((d) => ({
+          id: d.id,
+          name: d.name,
+          kind: 'Imported CSV',
+          modelCount: models.length,
+        })),
+      ],
+    };
+  }
+
+  private async sources(datasetId: string) {
+    const project = await this.project();
+    const models = await components.modelRepository.findAllBy({
+      projectId: project.id,
+    });
+    const { manifest } = await components.mdlService.makeCurrentModelMDL();
+    if (datasetId !== `project:${project.id}`) {
+      const upload = await components
+        .knex('explorer_dataset')
+        .where({ id: datasetId, project_id: project.id })
+        .first();
+      if (!upload || !serverConfig.dataOnlyMode)
+        throw new Error('Dataset is not accessible in the current project');
+      // Re-read schema: changes do not silently retain obsolete field definitions.
+      const adapter = components.wrenEngineAdaptor as LocalDuckdbAdaptor;
+      const physical = `explorer_uploads.${q(upload.physical_table)}`;
+      const metadata = await adapter.queryDuckdb(
+        `SELECT * FROM ${physical} LIMIT 0`,
+      );
+      const fields = metadata.columns.map((f) => ({
+        ...f,
+        label: humanize(f.name),
+        role: fieldRole(f.name, f.type),
+      }));
+      return {
+        project,
+        manifest: { ...manifest, models: [], views: [], relationships: [] },
+        name: upload.name,
+        modelCount: models.length,
+        views: [
+          {
+            id: 'table',
+            name: upload.name,
+            sql: `SELECT * FROM ${physical}`,
+            fields,
+            rowGrain: upload.row_grain,
+            sourceModelIds: [],
+            sourceNames: [],
+          },
+        ] as View[],
+      };
+    }
+    const columns =
+      await components.modelColumnRepository.findColumnsByModelIds(
+        models.map((m) => m.id),
+      );
+    const relations = await components.relationRepository.findRelationInfoBy(
+      { projectId: project.id },
+      undefined,
+    );
+    const views: View[] = models.map((m) => ({
+      id: `model:${m.id}`,
+      name: humanize(m.displayName || m.referenceName),
+      sql: `SELECT ${columns
+        .filter(
+          (c) =>
+            c.modelId === m.id &&
+            (!serverConfig.dataOnlyMode || !c.isCalculated),
+        )
+        .map((c) => q(c.referenceName))
+        .join(', ')} FROM ${q(m.referenceName)}`,
+      fields: columns
+        .filter(
+          (c) =>
+            c.modelId === m.id &&
+            (!serverConfig.dataOnlyMode || !c.isCalculated),
+        )
+        .map((c) => ({
+          name: c.referenceName,
+          label: humanize(c.displayName || c.referenceName),
+          type: c.type,
+          role: fieldRole(c.referenceName, c.type, !!c.isPk),
+          description: properties(c.properties).description,
+          targetTasks: Array.isArray(properties(c.properties).targetTasks)
+            ? properties(c.properties).targetTasks.filter((t) =>
+                ['classification', 'regression'].includes(t),
+              )
+            : undefined,
+        })),
+      rowGrain: properties(m.properties).rowGrain || 'Not defined',
+      sourceModelIds: [m.id],
+      sourceNames: [m.referenceName],
+    }));
+    if (project.sampleDataset === 'ECOMMERCE') {
+      const items = models.find(
+        (m) => m.sourceTableName === 'olist_order_items_dataset',
+      );
+      const orders = models.find(
+        (m) => m.sourceTableName === 'olist_orders_dataset',
+      );
+      const customers = models.find(
+        (m) => m.sourceTableName === 'olist_customers_dataset',
+      );
+      if (items && orders && customers) {
+        const col = (modelId: number, name: string) =>
+          columns.find(
+            (c) =>
+              c.modelId === modelId &&
+              c.sourceColumnName === name &&
+              !c.isCalculated,
+          );
+        const links = (a: number, ac: string, b: number, bc: string) => {
+          const ca = col(a, ac);
+          const cb = col(b, bc);
+          return (
+            ca &&
+            cb &&
+            relations.some(
+              (r) =>
+                (r.fromColumnId === ca.id && r.toColumnId === cb.id) ||
+                (r.toColumnId === ca.id && r.fromColumnId === cb.id),
+            )
+          );
+        };
+        if (
+          links(items.id, 'order_id', orders.id, 'order_id') &&
+          links(orders.id, 'customer_id', customers.id, 'customer_id')
+        ) {
+          const selections = [
+            [items.id, 'i', 'order_id', 'order_id'],
+            [items.id, 'i', 'order_item_id', 'order_item_id'],
+            [orders.id, 'o', 'order_purchase_timestamp', 'order_date'],
+            [customers.id, 'c', 'customer_state', 'customer_state'],
+            [orders.id, 'o', 'order_status', 'order_status'],
+            [items.id, 'i', 'price', 'item_price'],
+            [items.id, 'i', 'freight_value', 'freight_value'],
+            [items.id, 'i', 'product_id', 'product_id'],
+          ] as [number, string, string, string][];
+          if (selections.every(([id, , source]) => col(id, source))) {
+            const ref = (id: number, name: string) =>
+              q(col(id, name).referenceName);
+            views.unshift({
+              id: 'sales',
+              name: 'Sales overview',
+              sales: true,
+              keyQueries: [
+                [items, ['order_id', 'order_item_id']],
+                [orders, ['order_id']],
+                [customers, ['customer_id']],
+              ].map(([model, names]: [typeof items, string[]]) => {
+                const keys = names.map((name) => ref(model.id, name));
+                return `SELECT COUNT(*) AS n FROM (SELECT ${keys.join(', ')} FROM ${q(model.referenceName)} GROUP BY ${keys.join(', ')} HAVING COUNT(*) > 1 OR ${keys.map((key) => `${key} IS NULL`).join(' OR ')}) invalid_keys`;
+              }),
+              sourceNames: [
+                items.referenceName,
+                orders.referenceName,
+                customers.referenceName,
+              ],
+              sourceModelIds: [items.id, orders.id, customers.id],
+              rowGrain: 'One order item',
+              sql: `SELECT ${selections.map(([id, alias, source, name]) => `${alias}.${ref(id, source)} AS ${q(name)}`).join(', ')} FROM ${q(items.referenceName)} i LEFT JOIN ${q(orders.referenceName)} o ON i.${ref(items.id, 'order_id')} = o.${ref(orders.id, 'order_id')} LEFT JOIN ${q(customers.referenceName)} c ON o.${ref(orders.id, 'customer_id')} = c.${ref(customers.id, 'customer_id')}`,
+              fields: selections.map(([id, , source, name]) => ({
+                name,
+                label: humanize(name),
+                type: col(id, source).type,
+                role: fieldRole(name, col(id, source).type),
+                description:
+                  name === 'item_price'
+                    ? 'Item price; excludes freight. Currency is not specified in model metadata.'
+                    : undefined,
+              })),
+            });
+          }
+        }
+      }
+    }
+    return {
+      project,
+      manifest,
+      views,
+      modelCount: models.length,
+      name:
+        project.sampleDataset === 'ECOMMERCE'
+          ? 'WrenAI E-commerce'
+          : project.displayName || 'Connected data',
+    };
+  }
+
+  private manifestFor(manifest: Manifest, view: View): Manifest {
+    return {
+      ...manifest,
+      models: manifest.models
+        .filter((m) => view.sourceNames.includes(m.name))
+        .map((m) => ({
+          ...m,
+          columns: m.columns.filter(
+            (c) => !serverConfig.dataOnlyMode || !c.isCalculated,
+          ),
+        })),
+      views: [],
+      relationships: manifest.relationships,
+    };
+  }
+
+  async load(ref: Partial<ExplorerRef> = {}) {
+    const project = await this.project(ref.projectId);
+    const datasetId = ref.datasetId || `project:${project.id}`;
+    const sources = await this.sources(datasetId);
+    const view = ref.viewId
+      ? sources.views.find((d) => d.id === ref.viewId)
+      : sources.views[0];
+    if (!view || !view.fields.length)
+      throw new Error('This data view has no queryable fields');
+    const manifest = this.manifestFor(sources.manifest, view);
+    const schemaVersion = hash({
+      fields: view.fields,
+      sql: view.sql,
+      relationships: manifest.relationships,
+    });
+    if (ref.schemaVersion && ref.schemaVersion !== schemaVersion)
+      throw new Error(
+        'Schema changed. Reload this data view before continuing.',
+      );
+    const query = async (sql: string, limit = 10000) => {
+      const result = await components.queryService.preview(sql, {
+        project,
+        manifest,
+        limit,
+      });
+      const data = result as PreviewDataResponse;
+      if (!data.columns || !Array.isArray(data.data))
+        throw new Error('Query returned no data');
+      return data.data.map((row) =>
+        Object.fromEntries(data.columns.map((c, i) => [c.name, row[i]])),
+      );
+    };
+    if (view.sales) {
+      // Duplicate or null keys would multiply/drop items. Refuse this joined view.
+      for (const keyQuery of view.keyQueries) {
+        const result = await query(keyQuery, 1);
+        if (Number(result[0].n) > 0)
+          throw new Error(
+            'Sales overview requires unique, non-null keys. Use an individual model view to inspect the issue.',
+          );
+      }
+    }
+    const ctx: ExplorerContext = {
+      projectId: project.id,
+      datasetId,
+      viewId: view.id,
+      schemaVersion,
+      datasetName: sources.name,
+      viewName: view.name,
+      sourceModelIds: view.sourceModelIds,
+      modelCount: sources.modelCount,
+      fields: view.fields,
+      rowGrain: view.rowGrain,
+      dateField: view.fields.find((f) => f.role === 'date')?.name,
+      filterFields: [],
+      metricDefinitions: view.sales
+        ? [
+            'Item sales = SUM(item_price); freight excluded; currency unspecified.',
+            'Orders = COUNT(DISTINCT order_id).',
+            'Row key = (order_id, order_item_id).',
+          ]
+        : ['Rows = COUNT(*); no business metric inferred.'],
+      defaultFilters: view.sales
+        ? { values: { order_status: 'delivered' } }
+        : { values: {} },
+      filters: {},
+      charts: [],
+      views: sources.views.map((d) => ({ id: d.id, name: d.name })),
+    };
+    return { ctx, base: view.sql, query, manifest, project };
+  }
+
+  async profile(
+    loaded: Awaited<ReturnType<ExplorerService['load']>>,
+    filters?: ExplorerFilters,
+  ): Promise<ExplorerProfile> {
+    const { ctx, base, query } = loaded;
+    const sql = filters ? filteredSQL(base, ctx, filters) : base;
+    const stats = await query(
+      `SELECT COUNT(*) AS n${ctx.viewId === 'sales' ? ', SUM(item_price) AS item_sales, COUNT(DISTINCT order_id) AS distinct_orders' : ''}${serverConfig.dataOnlyMode ? `, SUM(CAST(HASH(${ctx.fields.map((f) => q(f.name)).join(', ')}) AS HUGEINT)) AS content_fingerprint` : ''}${ctx.dateField ? `, MIN(${q(ctx.dateField)}) AS date_min, MAX(${q(ctx.dateField)}) AS date_max` : ''}${ctx.fields.map((f, i) => `, COUNT(*) - COUNT(${q(f.name)}) AS null_${i}, COUNT(DISTINCT ${q(f.name)}) AS distinct_${i}`).join('')} FROM (${sql}) AS profile`,
+      1,
+    );
+    const row = stats[0];
+    const fieldStats = ctx.fields.map((f, i) => ({
+      name: f.name,
+      nullCount: Number(row[`null_${i}`]),
+      distinctCount: Number(row[`distinct_${i}`]),
+    }));
+    const categoryFields = ctx.fields
+      .filter(
+        (f) =>
+          f.role === 'category' &&
+          fieldStats.find((s) => s.name === f.name).distinctCount <= 100,
+      )
+      .slice(0, 4);
+    const options: Record<string, string[]> = {};
+    for (const f of categoryFields) {
+      const values = await query(
+        `SELECT DISTINCT CAST(${q(f.name)} AS VARCHAR) AS value FROM (${sql}) AS filter_options WHERE ${q(f.name)} IS NOT NULL ORDER BY value LIMIT 100`,
+        100,
+      );
+      options[f.name] = values.map((r) => r.value);
+    }
+    return {
+      rowCount: Number(row.n),
+      dateMin: row.date_min,
+      dateMax: row.date_max,
+      fields: fieldStats,
+      options,
+      // Floating SUM depends on scan/parallel reduction order. The native row
+      // fingerprint detects real content changes without that rounding noise.
+      datasetVersion: hash({
+        ...row,
+        item_sales: serverConfig.dataOnlyMode
+          ? undefined
+          : row.item_sales == null
+            ? row.item_sales
+            : Number(row.item_sales).toFixed(6),
+      }),
+      metrics:
+        ctx.viewId === 'sales'
+          ? {
+              itemSales:
+                row.item_sales === null ? null : Number(row.item_sales),
+              distinctOrders: Number(row.distinct_orders),
+            }
+          : undefined,
+    };
+  }
+
+  defaults(ctx: ExplorerContext, profile: ExplorerProfile): ChartDefinition[] {
+    const common = {
+      aggregation: 'count' as const,
+      measure: '__rows__',
+      timeGrain: 'month' as const,
+      categoryLimit: 5,
+      useCurrentFilters: true,
+    };
+    if (ctx.viewId === 'sales')
+      return [
+        {
+          ...common,
+          id: 'item-sales',
+          title: 'Item sales over time',
+          kind: 'time',
+          type: 'area',
+          groupBy: 'order_date',
+          measure: 'item_price',
+          aggregation: 'sum',
+        },
+        {
+          ...common,
+          id: 'orders-state',
+          title: 'Orders by customer state',
+          kind: 'category',
+          type: 'bar',
+          groupBy: 'customer_state',
+          measure: 'order_id',
+          aggregation: 'count_distinct',
+        },
+      ];
+    const charts: ChartDefinition[] = [];
+    if (ctx.dateField)
+      charts.push({
+        ...common,
+        id: 'rows-time',
+        title: 'Rows over time',
+        kind: 'time',
+        type: 'area',
+        groupBy: ctx.dateField,
+      });
+    const category = ctx.fields.find(
+      (f) =>
+        f.role === 'category' &&
+        profile.fields.find((p) => p.name === f.name)?.distinctCount <= 100,
+    );
+    if (category)
+      charts.push({
+        ...common,
+        id: 'rows-category',
+        title: `Rows by ${category.label.toLowerCase()}`,
+        kind: 'category',
+        type: 'bar',
+        groupBy: category.name,
+      });
+    const numeric = ctx.fields.find((f) => f.role === 'number');
+    if (numeric && charts.length < 2)
+      charts.push({
+        ...common,
+        id: 'distribution',
+        title: `${numeric.label} distribution`,
+        kind: 'distribution',
+        type: 'column',
+        groupBy: numeric.name,
+      });
+    return charts;
+  }
+
+  async context(ref: Partial<ExplorerRef>) {
+    const loaded = await this.load(ref);
+    const { ctx } = loaded;
+    const profile = await this.profile(loaded);
+    ctx.filterFields = Object.keys(profile.options);
+    const state = await components
+      .knex('explorer_state')
+      .where({
+        project_id: ctx.projectId,
+        dataset_id: ctx.datasetId,
+        view_id: ctx.viewId,
+      })
+      .orderBy('updated_at', 'desc')
+      .first();
+    const saved = state ? JSON.parse(state.state) : null;
+    ctx.filters = saved?.filters || ctx.defaultFilters;
+    try {
+      validateFilters(ctx, ctx.filters);
+    } catch {
+      ctx.filters = ctx.defaultFilters;
+    }
+    ctx.charts = saved?.charts || this.defaults(ctx, profile);
+    ctx.charts = ctx.charts.map((chart) => {
+      try {
+        validateChart(ctx.fields, chart);
+        return { ...chart, invalidReason: undefined };
+      } catch (e) {
+        return { ...chart, invalidReason: e.message };
+      }
+    });
+    return { context: ctx, profile };
+  }
+
+  async prepare(ref: ExplorerRef, filters: ExplorerFilters) {
+    const loaded = await this.load(ref);
+    // Filter fields are derived from actual types. No arbitrary SQL from the client.
+    loaded.ctx.filterFields = loaded.ctx.fields
+      .filter((f) => f.role === 'category')
+      .map((f) => f.name);
+    validateFilters(loaded.ctx, filters);
+    return loaded;
+  }
+
+  async rows(
+    ref: ExplorerRef,
+    filters: ExplorerFilters,
+    page = 1,
+    size = 10,
+    sort?: string,
+    direction = 'asc',
+  ) {
+    const { ctx, base, query } = await this.prepare(ref, filters);
+    if (
+      !Number.isInteger(page) ||
+      page < 1 ||
+      page > 100000 ||
+      !Number.isInteger(size) ||
+      size < 1 ||
+      size > 100
+    )
+      throw new Error('Invalid page');
+    if (sort && !ctx.fields.some((f) => f.name === sort))
+      throw new Error('Invalid sort field');
+    if (!['asc', 'desc'].includes(direction))
+      throw new Error('Invalid sort direction');
+    const sql = filteredSQL(base, ctx, filters);
+    const count = await query(
+      `SELECT COUNT(*) AS n FROM (${sql}) AS filtered`,
+      1,
+    );
+    const fallback =
+      ctx.fields
+        .filter((f) => f.role === 'identifier')
+        .map((f) => q(f.name))
+        .join(', ') || q(ctx.fields[0].name);
+    const rows = await query(
+      `SELECT * FROM (${sql}) AS preview ORDER BY ${sort ? `${q(sort)} ${direction} NULLS LAST` : fallback} LIMIT ${size} OFFSET ${(page - 1) * size}`,
+      size,
+    );
+    return { rows, total: Number(count[0].n) };
+  }
+
+  async chart(
+    loaded: Awaited<ReturnType<ExplorerService['load']>>,
+    filters: ExplorerFilters,
+    chart: ChartDefinition,
+  ): Promise<ChartResult> {
+    const sql = chartSQL(
+      chart.useCurrentFilters
+        ? filteredSQL(loaded.base, loaded.ctx, filters)
+        : loaded.base,
+      loaded.ctx.fields,
+      chart,
+    );
+    const rows = await loaded.query(sql);
+    let values = rows.map((r) => ({
+      label: r.label === null ? '(Unknown)' : r.label,
+      value: r.value === null ? null : Number(r.value),
+    }));
+    if (chart.kind === 'time') {
+      if (values.length >= 10000)
+        throw new Error(
+          'Too many time periods. Choose a wider time interval or a narrower date range.',
+        );
+      values = fillTimeGaps(values, chart.timeGrain);
+    }
+    return {
+      values,
+      metricLabel: metricLabel(chart),
+      scope: chart.useCurrentFilters
+        ? 'Current filters applied'
+        : 'All rows · current filters ignored',
+      sql,
+    };
+  }
+
+  async save(
+    ref: ExplorerRef,
+    filters: ExplorerFilters,
+    charts: ChartDefinition[],
+  ) {
+    const { ctx } = await this.prepare(ref, filters);
+    if (!Array.isArray(charts) || charts.length > 10)
+      throw new Error('At most 10 charts are supported');
+    for (const chart of charts) {
+      // Existing invalid definitions are retained for repair, never queried.
+      try {
+        validateChart(ctx.fields, chart);
+      } catch (e) {
+        if (!chart.invalidReason) throw e;
+      }
+    }
+    const key = hash({
+      projectId: ctx.projectId,
+      datasetId: ctx.datasetId,
+      viewId: ctx.viewId,
+      schemaVersion: ctx.schemaVersion,
+    });
+    await components
+      .knex('explorer_state')
+      .insert({
+        key,
+        project_id: ctx.projectId,
+        dataset_id: ctx.datasetId,
+        view_id: ctx.viewId,
+        schema_version: ctx.schemaVersion,
+        state: JSON.stringify({ filters, charts }),
+        updated_at: new Date().toISOString(),
+      })
+      .onConflict('key')
+      .merge();
+    return { saved: true };
+  }
+
+  newId() {
+    return randomUUID();
+  }
+}
+
+export const explorerService = new ExplorerService();
