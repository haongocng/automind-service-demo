@@ -0,0 +1,45 @@
+import { ReportVisual } from './types';
+
+/** Only declarative inline charts and owned raster artifacts enter the renderer. */
+export function visualIssue(visual: ReportVisual): string | undefined {
+  if (visual.kind === 'image')
+    return /^\/api\/explorer\/artifacts\/[a-z0-9_-]+\.(png|jpe?g|webp)$/i.test(
+      visual.imageRef || '',
+    )
+      ? undefined
+      : 'This image artifact is unavailable or unsupported.';
+  const spec = visual.chartSpec;
+  if (
+    !spec ||
+    !Array.isArray(spec.data?.values) ||
+    !spec.encoding ||
+    !spec.mark
+  )
+    return 'This chart artifact is incomplete.';
+  if (
+    Object.keys(spec).some((key) => !['data', 'mark', 'encoding'].includes(key))
+  )
+    return 'This chart specification is unsupported.';
+  const mark = typeof spec.mark === 'string' ? spec.mark : spec.mark.type;
+  if (!['bar', 'line', 'area', 'point', 'rect', 'boxplot'].includes(mark))
+    return 'This chart mark is unsupported.';
+  const unsafe = (value: any): boolean =>
+    value &&
+    typeof value === 'object' &&
+    Object.entries(value).some(
+      ([key, child]) =>
+        [
+          'url',
+          'href',
+          'expr',
+          'signal',
+          'calculate',
+          'on',
+          'init',
+          'update',
+        ].includes(key) || unsafe(child),
+    );
+  return unsafe(spec)
+    ? 'This chart contains unsupported external data or expressions.'
+    : undefined;
+}
diff --git a/wren-ui/src/utils/explorer/query.test.ts b/wren-ui/src/utils/explorer/query.test.ts
new file mode 100644
index 00000000..4b4a4f30
--- /dev/null
+++ b/wren-ui/src/utils/explorer/query.test.ts
@@ -0,0 +1,138 @@
+import { Database } from 'duckdb-async';
+import {
+  chartSQL,
+  fieldRole,
+  fillTimeGaps,
+  filteredSQL,
+  validateChart,
+} from './query';
+import { ChartDefinition, ExplorerField } from './types';
+
+const fields: ExplorerField[] = [
+  { name: 'order_id', type: 'VARCHAR', role: 'identifier', label: 'Order' },
+  { name: 'order_date', type: 'TIMESTAMP', role: 'date', label: 'Date' },
+  { name: 'order_status', type: 'VARCHAR', role: 'category', label: 'Status' },
+  { name: 'customer_state', type: 'VARCHAR', role: 'category', label: 'State' },
+  { name: 'item_price', type: 'DOUBLE', role: 'number', label: 'Price' },
+];
+const context = {
+  fields,
+  dateField: 'order_date',
+  filterFields: ['customer_state', 'order_status'],
+};
+const baseChart: ChartDefinition = {
+  id: 'fixture',
+  title: 'Fixture orders',
+  kind: 'category',
+  type: 'bar',
+  groupBy: 'customer_state',
+  measure: 'order_id',
+  aggregation: 'count_distinct',
+  categoryLimit: 5,
+  timeGrain: 'month',
+  useCurrentFilters: true,
+};
+
+describe('Explorer population queries (disposable test fixture)', () => {
+  let db: Database;
+  const base = `SELECT i.order_id, i.price AS item_price, o.order_date, o.order_status, c.customer_state FROM items i LEFT JOIN orders o ON i.order_id = o.order_id LEFT JOIN customers c ON o.customer_id = c.customer_id`;
+  beforeAll(async () => {
+    db = await Database.create(':memory:');
+    await db.exec(
+      `CREATE TABLE customers(customer_id VARCHAR, customer_state VARCHAR); INSERT INTO customers VALUES ('c1','SP'), ('c2','RJ'); CREATE TABLE orders(order_id VARCHAR, customer_id VARCHAR, order_date TIMESTAMP, order_status VARCHAR); INSERT INTO orders VALUES ('o1','c1','2018-01-10','delivered'),('o2','c2','2018-03-10','delivered'),('o3','c1','2018-02-10','canceled'); CREATE TABLE items(order_id VARCHAR, order_item_id INT, price DOUBLE); INSERT INTO items VALUES ('o1',1,40),('o1',2,60),('o2',1,20),('o3',1,100);`,
+    );
+  });
+  afterAll(async () => {
+    await db.close();
+  });
+  it('sums 120 in item prices, counts two orders rather than three item rows', async () => {
+    const filtered = filteredSQL(base, context, {
+      values: { order_status: 'delivered' },
+    });
+    const prices = await db.all(
+      chartSQL(filtered, fields, {
+        ...baseChart,
+        groupBy: 'order_date',
+        kind: 'time',
+        type: 'area',
+        measure: 'item_price',
+        aggregation: 'sum',
+      }),
+    );
+    expect(prices.reduce((n, r) => n + r.value, 0)).toBe(120);
+    const counts = await db.all(chartSQL(filtered, fields, baseChart));
+    expect(counts).toEqual([
+      { label: 'RJ', value: BigInt(1) },
+      { label: 'SP', value: BigInt(1) },
+    ]);
+    expect(counts.reduce((n, r) => n + Number(r.value), 0)).toBe(2);
+  });
+  it('handles date boundaries, literal quote filters, null sums, and empty scopes', async () => {
+    const filtered = filteredSQL(base, context, {
+      from: '2018-01-10',
+      to: '2018-01-10',
+      values: { order_status: 'delivered' },
+    });
+    expect(
+      (await db.all(`SELECT COUNT(*) AS n FROM (${filtered}) x`))[0].n,
+    ).toBe(BigInt(2));
+    const noRows = filteredSQL(base, context, {
+      values: { customer_state: "SP' OR 1=1 --" },
+    });
+    expect(await db.all(chartSQL(noRows, fields, baseChart))).toEqual([]);
+    const nullBase =
+      "SELECT 'SP' AS customer_state, NULL::DOUBLE AS item_price";
+    expect(
+      (
+        await db.all(
+          chartSQL(nullBase, fields, {
+            ...baseChart,
+            measure: 'item_price',
+            aggregation: 'sum',
+          }),
+        )
+      )[0].value,
+    ).toBeNull();
+  });
+  it('keeps a missing month as null and refuses removed fields or summed IDs', () => {
+    expect(
+      fillTimeGaps(
+        [
+          { label: '2018-01-01', value: 100 },
+          { label: '2018-03-01', value: 20 },
+        ],
+        'month',
+      )[1],
+    ).toEqual({ label: '2018-02-01', value: null });
+    expect(() =>
+      validateChart(fields, { ...baseChart, aggregation: 'sum' }),
+    ).toThrow('numeric field');
+    expect(() =>
+      validateChart(
+        fields.filter((f) => f.name !== 'order_id'),
+        baseChart,
+      ),
+    ).toThrow('no longer available');
+    expect(fieldRole('order_item_id', 'BIGINT')).toBe('identifier');
+    expect(fieldRole('CustomerID', 'BIGINT')).toBe('identifier');
+    expect(fieldRole('customerId', 'BIGINT')).toBe('identifier');
+    expect(fieldRole('paid', 'BIGINT')).toBe('number');
+  });
+  it('queries a numeric distribution with a stable constant-value bin', async () => {
+    const result = await db.all(
+      chartSQL(
+        'SELECT 7.0 AS item_price UNION ALL SELECT NULL UNION ALL SELECT 7.0',
+        fields,
+        {
+          ...baseChart,
+          kind: 'distribution',
+          type: 'column',
+          groupBy: 'item_price',
+          measure: '__rows__',
+          aggregation: 'count',
+        },
+      ),
+    );
+    expect(result).toEqual([{ label: 7, value: BigInt(2) }]);
+  });
+});
diff --git a/wren-ui/src/utils/explorer/query.ts b/wren-ui/src/utils/explorer/query.ts
new file mode 100644
index 00000000..49e8ccef
--- /dev/null
+++ b/wren-ui/src/utils/explorer/query.ts
@@ -0,0 +1,181 @@
+import {
+  ChartDefinition,
+  ExplorerContext,
+  ExplorerField,
+  ExplorerFilters,
+} from './types';
+
+export const quoteId = (s: string) => `"${s.replace(/"/g, '""')}"`;
+export const quoteValue = (s: string) => `'${s.replace(/'/g, "''")}'`;
+export const humanize = (s: string) =>
+  s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
+export function fieldRole(
+  name: string,
+  type: string,
+  isPk = false,
+): ExplorerField['role'] {
+  if (
+    isPk ||
+    /(^id$|_id$|uuid|_code$|zip_code|_sequential$)/i.test(name) ||
+    /[a-z](?:ID|Id)$/.test(name)
+  )
+    return 'identifier';
+  if (/date|timestamp|datetime/i.test(type)) return 'date';
+  if (/int|decimal|numeric|double|float|real|number/i.test(type))
+    return 'number';
+  if (/char|text|string|bool/i.test(type)) return 'category';
+  return 'other';
+}
+export function validateFilters(
+  ctx: Pick<ExplorerContext, 'fields' | 'dateField' | 'filterFields'>,
+  filters: ExplorerFilters,
+) {
+  if (!filters || typeof filters !== 'object' || Array.isArray(filters))
+    throw new Error('Invalid filters');
+  for (const d of [filters.from, filters.to]) {
+    if (
+      d &&
+      (!ctx.dateField ||
+        !/^\d{4}-\d{2}-\d{2}$/.test(d) ||
+        new Date(d).toISOString().slice(0, 10) !== d)
+    )
+      throw new Error('Invalid date range');
+  }
+  if (filters.from && filters.to && filters.from > filters.to)
+    throw new Error('Start date must precede end date');
+  for (const [name, value] of Object.entries(filters.values || {})) {
+    if (
+      !ctx.filterFields.includes(name) ||
+      typeof value !== 'string' ||
+      value.length > 1000
+    )
+      throw new Error('Invalid filter field or value');
+  }
+}
+export function filteredSQL(
+  base: string,
+  ctx: Pick<ExplorerContext, 'fields' | 'dateField' | 'filterFields'>,
+  filters: ExplorerFilters,
+) {
+  validateFilters(ctx, filters);
+  const conditions: string[] = [];
+  if (filters.from)
+    conditions.push(
+      `CAST(${quoteId(ctx.dateField)} AS DATE) >= DATE ${quoteValue(filters.from)}`,
+    );
+  if (filters.to)
+    conditions.push(
+      `CAST(${quoteId(ctx.dateField)} AS DATE) <= DATE ${quoteValue(filters.to)}`,
+    );
+  for (const [name, value] of Object.entries(filters.values || {}))
+    conditions.push(`CAST(${quoteId(name)} AS VARCHAR) = ${quoteValue(value)}`);
+  return `SELECT * FROM (${base}) AS explorer_data${conditions.length ? ` WHERE ${conditions.join(' AND ')}` : ''}`;
+}
+export function validateChart(fields: ExplorerField[], chart: ChartDefinition) {
+  if (
+    !chart ||
+    !/^[a-zA-Z0-9_-]{1,80}$/.test(chart.id) ||
+    typeof chart.title !== 'string' ||
+    !chart.title.trim() ||
+    chart.title.length > 150
+  )
+    throw new Error('Chart ID and title are required');
+  const group = fields.find((f) => f.name === chart.groupBy);
+  const measure = fields.find((f) => f.name === chart.measure);
+  if (!group)
+    throw new Error(`Group field ${chart.groupBy} is no longer available`);
+  if (
+    !['count', 'count_distinct', 'sum', 'avg', 'min', 'max'].includes(
+      chart.aggregation,
+    )
+  )
+    throw new Error('Invalid aggregation');
+  if (chart.measure === '__rows__') {
+    if (chart.aggregation !== 'count')
+      throw new Error('Rows support Count only');
+  } else if (!measure)
+    throw new Error(`Measure ${chart.measure} is no longer available`);
+  else if (
+    ['sum', 'avg', 'min', 'max'].includes(chart.aggregation) &&
+    measure.role !== 'number'
+  )
+    throw new Error(
+      'This aggregation requires a numeric field that is not an identifier',
+    );
+  if (!['time', 'category', 'distribution'].includes(chart.kind))
+    throw new Error('Invalid chart kind');
+  if (!['line', 'area', 'bar', 'column', 'table'].includes(chart.type))
+    throw new Error('Invalid chart type');
+  if (chart.kind === 'time' && group.role !== 'date')
+    throw new Error('Time charts need a date field');
+  if (
+    chart.kind === 'distribution' &&
+    (group.role !== 'number' || chart.measure !== '__rows__')
+  )
+    throw new Error('Distributions require a numeric field and row counts');
+  if (chart.kind === 'category' && group.role === 'date')
+    throw new Error('Use a time chart for dates');
+  if (!['day', 'week', 'month', 'year'].includes(chart.timeGrain))
+    throw new Error('Invalid time interval');
+  if (
+    !Number.isInteger(chart.categoryLimit) ||
+    chart.categoryLimit < 1 ||
+    chart.categoryLimit > 100
+  )
+    throw new Error('Category limit must be between 1 and 100');
+  if (typeof chart.useCurrentFilters !== 'boolean')
+    throw new Error('Invalid filter scope');
+}
+export const metricLabel = (chart: ChartDefinition) =>
+  chart.measure === '__rows__'
+    ? 'Row count'
+    : `${humanize(chart.aggregation)} of ${humanize(chart.measure)}`;
+export function chartSQL(
+  base: string,
+  fields: ExplorerField[],
+  chart: ChartDefinition,
+) {
+  validateChart(fields, chart);
+  const q = quoteId;
+  const metric =
+    chart.measure === '__rows__'
+      ? 'COUNT(*)'
+      : chart.aggregation === 'count_distinct'
+        ? `COUNT(DISTINCT ${q(chart.measure)})`
+        : `${chart.aggregation.toUpperCase()}(${q(chart.measure)})`;
+  if (chart.kind === 'distribution') {
+    // Fixed-width bins calculated from the whole filtered population, excluding nulls.
+    const field = q(chart.groupBy);
+    return `WITH src AS (${base}), bounds AS (SELECT MIN(${field}) AS lo, MAX(${field}) AS hi FROM src), bins AS (SELECT CASE WHEN hi = lo THEN lo ELSE lo + LEAST(9, FLOOR((${field} - lo) / NULLIF(hi - lo, 0) * 10)) * (hi - lo) / 10 END AS label FROM src CROSS JOIN bounds WHERE ${field} IS NOT NULL) SELECT label, COUNT(*) AS value FROM bins GROUP BY label ORDER BY label`;
+  }
+  const label =
+    chart.kind === 'time'
+      ? `DATE_TRUNC(${quoteValue(chart.timeGrain)}, ${q(chart.groupBy)})`
+      : `CAST(${q(chart.groupBy)} AS VARCHAR)`;
+  return `SELECT ${label} AS label, ${metric} AS value FROM (${base}) AS chart_data${chart.kind === 'time' ? ` WHERE ${q(chart.groupBy)} IS NOT NULL` : ''} GROUP BY 1 ORDER BY ${chart.kind === 'time' ? 'label ASC' : 'value DESC NULLS LAST, label ASC'}${chart.kind === 'category' ? ` LIMIT ${chart.categoryLimit}` : ''}`;
+}
+export function fillTimeGaps(
+  values: { label: string | number; value: number | null }[],
+  interval: ChartDefinition['timeGrain'],
+) {
+  if (values.length < 2) return values;
+  const map = new Map(
+    values.map((v) => [String(v.label).slice(0, 10), v.value]),
+  );
+  const cursor = new Date(String(values[0].label));
+  const last = new Date(String(values[values.length - 1].label));
+  const result: typeof values = [];
+  while (cursor <= last && result.length < 10000) {
+    const label = cursor.toISOString().slice(0, 10);
+    result.push({ label, value: map.has(label) ? map.get(label) : null });
+    if (interval === 'month') cursor.setUTCMonth(cursor.getUTCMonth() + 1);
+    else if (interval === 'year')
+      cursor.setUTCFullYear(cursor.getUTCFullYear() + 1);
+    else cursor.setUTCDate(cursor.getUTCDate() + (interval === 'week' ? 7 : 1));
+  }
+  if (cursor <= last)
+    throw new Error(
+      'Too many time periods. Choose a wider time interval or a narrower date range.',
+    );
+  return result;
+}
