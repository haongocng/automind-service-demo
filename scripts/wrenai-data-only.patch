new file mode 100644
index 00000000..4e13a80f
--- /dev/null
+++ b/wren-ui/src/utils/analysis/presentation.ts
@@ -0,0 +1,84 @@
+import { AnalysisReport } from './types';
+
+const implementationNote =
+  /rule-based explanations|goal does not invoke an LLM|not the full AutoMind paper|existing ML stack|goal was not executed by an LLM|Chart definitions can use their own unfiltered scope/i;
+
+function readable(text: string) {
+  return text
+    .replace(/sum of item price/gi, 'Item sales (price units)')
+    .replace(/count distinct of order id/gi, 'Distinct orders')
+    .replace(
+      /Item sales = SUM\(item_price\)/gi,
+      'Item sales total the item prices',
+    )
+    .replace(
+      /Orders = COUNT\(DISTINCT order_id\)/gi,
+      'Each order is counted once',
+    )
+    .replace(
+      /Row key = \(order_id, order_item_id\)\.?/gi,
+      'Each row is one order item.',
+    )
+    .replace(
+      /\b(count_distinct|sum|mean|count)\(([^)]+)\)/gi,
+      (_, aggregation, field) =>
+        `${aggregation === 'count_distinct' ? 'Distinct count of' : aggregation === 'sum' ? 'Total' : aggregation === 'mean' ? 'Average' : 'Count of'} ${field.replace(/_/g, ' ')}`,
+    )
+    .replace(/\b\d+(?:\.\d+)?e[+-]\d+\b/gi, (value) =>
+      Number(value).toLocaleString('en-US', { maximumFractionDigits: 2 }),
+    );
+}
+
+/** Improve the display of saved reports without rewriting their frozen evidence. */
+export function presentReport(report: AnalysisReport): AnalysisReport {
+  const findings = report.findings.map((finding) => ({
+    ...finding,
+    interpretation: readable(finding.interpretation),
+  }));
+  const limitations = report.limitations.filter(
+    (text) => !implementationNote.test(text),
+  );
+  if (!limitations.length) {
+    if (report.task === 'exploration') {
+      limitations.push(
+        'These findings describe the selected records and filters. They do not establish causes or guarantee that a trend will continue.',
+      );
+      if (report.scope.ref.viewId === 'sales')
+        limitations.push(
+          'Item prices exclude freight and do not measure profit. An order can contain several items, so item counts and distinct order counts have different meanings.',
+        );
+    } else if (report.task === 'clustering') {
+      limitations.push(
+        'Group profiles depend on the selected characteristics. The two-dimensional display may conceal overlap in other characteristics; check distributions and stability in another sample before acting on the segments.',
+      );
+    } else {
+      limitations.push(
+        'Evaluation describes held-out records from the selected population. Performance for another cohort or a changed target distribution remains unmeasured.',
+      );
+    }
+  }
+  const insights = report.insights?.length
+    ? report.insights
+    : findings.slice(0, 4).map((finding) => ({
+        id: finding.id,
+        title: finding.title,
+        detail: finding.interpretation,
+        evidenceIds: finding.evidenceIds,
+      }));
+  return {
+    ...report,
+    summary: report.summary
+      .filter((text) => !implementationNote.test(text))
+      .map(readable),
+    findings,
+    insights: insights.map((item) => ({
+      ...item,
+      detail: readable(item.detail),
+    })),
+    limitations,
+    visuals: report.visuals.map((visual) => ({
+      ...visual,
+      caption: readable(visual.caption),
+    })),
+  };
+}
