diff --git a/wren-ui/src/components/analysis/ReportVisual.tsx b/wren-ui/src/components/analysis/ReportVisual.tsx
new file mode 100644
index 00000000..74884ed8
--- /dev/null
+++ b/wren-ui/src/components/analysis/ReportVisual.tsx
@@ -0,0 +1,101 @@
+import { useEffect, useRef, useState } from 'react';
+import dynamic from 'next/dynamic';
+import { Alert, Button } from 'antd';
+import { ReportVisual as Visual } from '@/utils/analysis/types';
+import { visualIssue } from '@/utils/analysis/visual';
+
+const Chart = dynamic(() => import('@/components/chart'), { ssr: false });
+export default function ReportVisual({ visual }: { visual: Visual }) {
+  const container = useRef<HTMLDivElement>();
+  const [width, setWidth] = useState(400);
+  const [retry, setRetry] = useState(0);
+  const [imageError, setImageError] = useState(false);
+  const [chartError, setChartError] = useState<string>();
+  useEffect(() => {
+    const observer = new ResizeObserver((entries) =>
+      setWidth(Math.max(120, entries[0].contentRect.width)),
+    );
+    if (container.current) observer.observe(container.current);
+    return () => observer.disconnect();
+  }, []);
+  const issue = visualIssue(visual);
+  return (
+    <div className="visual" ref={container} aria-label={visual.altText}>
+      <h3>{visual.title}</h3>
+      {issue || imageError || chartError ? (
+        <Alert
+          type="warning"
+          showIcon
+          message="Visual could not be loaded"
+          description={
+            issue || chartError || 'This image artifact is unavailable.'
+          }
+          action={
+            <Button
+              size="small"
+              onClick={() => {
+                setImageError(false);
+                setChartError(undefined);
+                setRetry((n) => n + 1);
+              }}
+            >
+              Retry visual
+            </Button>
+          }
+        />
+      ) : visual.kind === 'image' ? (
+        <img
+          key={retry}
+          src={visual.imageRef}
+          alt={visual.altText}
+          onError={() => setImageError(true)}
+        />
+      ) : (
+        <Chart
+          key={retry}
+          spec={
+            {
+              ...visual.chartSpec,
+              width,
+              height: 325,
+              autosize: { type: 'fit', contains: 'padding', resize: true },
+              config: {
+                view: { stroke: null },
+                legend: {
+                  orient: 'bottom',
+                  direction: 'horizontal',
+                  labelLimit: 170,
+                },
+                axis: {
+                  labelColor: '#586581',
+                  titleColor: '#586581',
+                  titleFontWeight: 400,
+                  labelLimit: 140,
+                },
+                range: {
+                  category: [
+                    '#164dff',
+                    '#e58b15',
+                    '#4fba95',
+                    '#9c60d7',
+                    '#dd6395',
+                    '#67a6d6',
+                  ],
+                },
+              },
+            } as any
+          }
+          values={visual.chartSpec.data.values}
+          width={width}
+          height={325}
+          hideActions
+          hideTitle
+          preserveSpec
+          forceUpdate={retry}
+          onError={setChartError}
+        />
+      )}
+      <p className="caption">{visual.caption}</p>
+    </div>
+  );
+}
diff --git a/wren-ui/src/components/explorer/ChartEditor.tsx b/wren-ui/src/components/explorer/ChartEditor.tsx
new file mode 100644
index 00000000..9fb3f974
--- /dev/null
+++ b/wren-ui/src/components/explorer/ChartEditor.tsx
@@ -0,0 +1,218 @@
+import { useState } from 'react';
+import { Alert, Button, Input, Radio, Select, Switch } from 'antd';
+import CloseOutlined from '@ant-design/icons/CloseOutlined';
+import {
+  ChartDefinition,
+  ExplorerContext,
+  ExplorerFilters,
+} from '@/utils/explorer/types';
+import { humanize, validateChart } from '@/utils/explorer/query';
+import ExplorerChart from './ExplorerChart';
+
+export default function ChartEditor({
+  context,
+  filters,
+  chart,
+  onSave,
+  onClose,
+}: {
+  context: ExplorerContext;
+  filters: ExplorerFilters;
+  chart: ChartDefinition;
+  onSave: (d: ChartDefinition) => Promise<void>;
+  onClose: () => void;
+}) {
+  const [draft, setDraft] = useState<ChartDefinition>({
+    ...chart,
+    invalidReason: undefined,
+  });
+  const [saving, setSaving] = useState(false);
+  const [saveError, setSaveError] = useState<string>();
+  const update = (value: Partial<ChartDefinition>) => {
+    setDraft({ ...draft, ...value });
+    setSaveError(undefined);
+  };
+  let validation: string;
+  try {
+    validateChart(context.fields, draft);
+  } catch (error) {
+    validation = error.message;
+  }
+  const groups = context.fields.filter((f) =>
+    draft.kind === 'time'
+      ? f.role === 'date'
+      : draft.kind === 'distribution'
+        ? f.role === 'number'
+        : f.role !== 'date',
+  );
+  const measure = context.fields.find((f) => f.name === draft.measure);
+  const aggregations =
+    draft.measure === '__rows__'
+      ? ['count']
+      : measure?.role === 'number'
+        ? ['count', 'count_distinct', 'sum', 'avg', 'min', 'max']
+        : ['count', 'count_distinct'];
+  const save = async () => {
+    setSaving(true);
+    try {
+      await onSave(draft);
+      onClose();
+    } catch (error) {
+      setSaveError(error.message);
+    } finally {
+      setSaving(false);
+    }
+  };
+  return (
+    <aside className="explorer-panel" aria-label="Customize chart">
+      <div className="panel-scroll">
+        <div className="panel-heading">
+          <h2>Customize chart</h2>
+          <Button
+            type="text"
+            icon={<CloseOutlined />}
+            aria-label="Close chart editor"
+            onClick={onClose}
+          />
+        </div>
+        <p className="explorer-muted">
+          Adjust this chart using the current data view.
+        </p>
+        <label className="explorer-field">
+          Chart title
+          <Input
+            value={draft.title}
+            maxLength={150}
+            onChange={(e) => update({ title: e.target.value })}
+          />
+        </label>
+        <label className="explorer-field">
+          Chart type
+          <Radio.Group
+            value={draft.type}
+            onChange={(e) => update({ type: e.target.value })}
+            optionType="button"
+            buttonStyle="solid"
+            options={(draft.kind === 'time'
+              ? ['area', 'line', 'table']
+              : ['bar', 'column', 'table']
+            ).map((value) => ({ value, label: humanize(value) }))}
+          />
+        </label>
+        <label className="explorer-field">
+          Group by
+          <Select
+            value={draft.groupBy}
+            options={groups.map((f) => ({ label: f.name, value: f.name }))}
+            onChange={(groupBy) => update({ groupBy })}
+          />
+        </label>
+        {draft.kind !== 'distribution' && (
+          <>
+            <label className="explorer-field">
+              Measure
+              <Select
+                value={draft.measure}
+                options={[
+                  { label: 'Rows', value: '__rows__' },
+                  ...context.fields.map((f) => ({
+                    label: f.name,
+                    value: f.name,
+                  })),
+                ]}
+                onChange={(measure) =>
+                  update({
+                    measure,
+                    aggregation:
+                      measure === '__rows__' ? 'count' : 'count_distinct',
+                  })
+                }
+              />
+            </label>
+            <label className="explorer-field">
+              Aggregation
+              <Select
+                value={draft.aggregation}
+                options={aggregations.map((value) => ({
+                  value,
+                  label: humanize(value),
+                }))}
+                onChange={(aggregation) =>
+                  update({
+                    aggregation: aggregation as ChartDefinition['aggregation'],
+                  })
+                }
+              />
+            </label>
+          </>
+        )}
+        {draft.kind === 'time' ? (
+          <label className="explorer-field">
+            Time interval
+            <Select
+              value={draft.timeGrain}
+              options={['day', 'week', 'month', 'year'].map((value) => ({
+                value,
+                label: humanize(value),
+              }))}
+              onChange={(timeGrain) => update({ timeGrain })}
+            />
+          </label>
+        ) : (
+          draft.kind === 'category' && (
+            <label className="explorer-field">
+              Category limit
+              <Select
+                value={draft.categoryLimit}
+                options={[5, 10, 25, 50, 100].map((value) => ({
+                  value,
+                  label: `Top ${value}`,
+                }))}
+                onChange={(categoryLimit) => update({ categoryLimit })}
+              />
+            </label>
+          )
+        )}
+        <div className="filter-switch">
+          <Switch
+            checked={draft.useCurrentFilters}
+            onChange={(useCurrentFilters) => update({ useCurrentFilters })}
+          />
+          <div>
+            Use current filters
+            <p className="explorer-muted">
+              {draft.useCurrentFilters
+                ? 'Shared date range and filters'
+                : 'All rows in this view; filters ignored'}
+            </p>
+          </div>
+        </div>
+        <div className="explorer-card">
+          <h4>Chart preview</h4>
+          {validation ? (
+            <Alert type="warning" message={validation} />
+          ) : (
+            <ExplorerChart
+              context={context}
+              filters={filters}
+              chart={draft}
+              draft
+            />
+          )}
+        </div>
+        {saveError && <Alert type="error" message={saveError} />}
+      </div>
+      <div className="panel-footer">
+        <Button
+          type="primary"
+          disabled={!!validation}
+          loading={saving}
+          onClick={save}
+        >
+          Save chart
+        </Button>
+        <Button onClick={onClose}>Cancel</Button>
+      </div>
+    </aside>
+  );
+}
