+import { components, serverConfig } from '@/common';
+import { LocalDuckdbAdaptor } from '../adaptors/localDuckdbAdaptor';
+import {
+  AnalysisRecord,
+  ChartDefinition,
+  ExplorerFilters,
+  ExplorerRef,
+} from '@/utils/explorer/types';
+import { validateChart } from '@/utils/explorer/query';
+import { explorerService, hash } from './explorerService';
+
+/** Keeps prediction APIs intact; exploration uses full-scope descriptive evidence. */
+export async function runExplorerAnalysis(input: {
+  id: string;
+  ref: ExplorerRef;
+  filters: ExplorerFilters;
+  charts: ChartDefinition[];
+  goal: string;
+  includeCharts: boolean;
+}) {
+  if (
+    !/^[a-f0-9-]{36}$/.test(input.id) ||
+    typeof input.goal !== 'string' ||
+    !input.goal.trim() ||
+    input.goal.length > 2000
+  )
+    throw new Error('A valid run ID and analysis goal are required');
+  const project = await explorerService.project(input.ref.projectId);
+  const requestHash = hash(input);
+  const prior = await components
+    .knex('explorer_analysis')
+    .where({ id: input.id, project_id: project.id })
+    .first();
+  if (prior) {
+    if (prior.request_hash !== requestHash)
+      throw new Error('This run ID already belongs to another request');
+    return JSON.parse(prior.record) as AnalysisRecord;
+  }
+  const { context } = await explorerService.context(input.ref);
+  const loaded = await explorerService.prepare(input.ref, input.filters);
+  const definitions = input.includeCharts
+    ? input.charts
+    : explorerService.defaults(context, await explorerService.profile(loaded));
+  if (!Array.isArray(definitions) || definitions.length > 10)
+    throw new Error('Invalid chart definitions');
+  definitions.forEach((d) => validateChart(context.fields, d));
+  const snapshotId = `snapshot_${input.id.replace(/-/g, '')}`;
+  const record: AnalysisRecord = {
+    id: input.id,
+    status: 'running',
+    createdAt: new Date().toISOString(),
+    goal: input.goal.trim(),
+    context: { ...context, filters: input.filters, charts: definitions },
+    filters: input.filters,
+    snapshotId,
+  };
+  // Unique ID is the cross-request lock, including concurrent requests.
+  try {
+    await components.knex('explorer_analysis').insert({
+      id: record.id,
+      project_id: project.id,
+      request_hash: requestHash,
+      status: 'running',
+      created_at: record.createdAt,
+      record: JSON.stringify(record),
+    });
+  } catch (error) {
+    const duplicate = await components
+      .knex('explorer_analysis')
+      .where({ id: input.id, project_id: project.id })
+      .first();
+    if (!duplicate || duplicate.request_hash !== requestHash) throw error;
+    return JSON.parse(duplicate.record) as AnalysisRecord;
+  }
+  let materialized = false;
+  try {
+    if (serverConfig.dataOnlyMode) {
+      const adapter = components.wrenEngineAdaptor as LocalDuckdbAdaptor;
+      loaded.base = await adapter.createExplorerSnapshot(
+        snapshotId,
+        loaded.base,
+        loaded.manifest,
+      );
+      materialized = true;
+      loaded.query = async (sql: string) => {
+        const data = await adapter.queryDuckdb(sql);
+        return data.data.map((row) =>
+          Object.fromEntries(data.columns.map((c, i) => [c.name, row[i]])),
+        );
+      };
+    }
+    const profile = await explorerService.profile(loaded, input.filters);
+    const evidence = await Promise.all(
+      definitions.map(async (chart) => ({
+        title: chart.title,
+        definition: `${chart.aggregation}(${chart.measure}) grouped by ${chart.groupBy}${chart.kind === 'time' ? ` / ${chart.timeGrain}` : ''}`,
+        chart,
+        ...(await explorerService.chart(loaded, input.filters, chart)),
+      })),
+    );
+    const endpoint =
+      process.env.AUTOMIND_EXPLORATION_URL ||
+      'http://127.0.0.1:8000/analyze/exploration';
+    const response = await fetch(endpoint, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        snapshotId,
+        goal: record.goal,
+        context: record.context,
+        profile,
+        evidence,
+        method: materialized
+          ? 'Materialized full-view snapshot; SQL aggregates over the frozen population'
+          : 'Frozen query-result aggregates; remote source is not a transactional snapshot',
+      }),
+      signal: AbortSignal.timeout(60000),
+    });
+    if (!response.ok)
+      throw new Error(`Analysis service returned ${response.status}`);
+    record.result = await response.json();
+    record.status = 'completed';
+  } catch (error) {
+    record.status = 'failed';
+    record.error = error.message || 'Analysis could not be completed';
+  } finally {
+    await components
+      .knex('explorer_analysis')
+      .where({ id: record.id, project_id: project.id })
+      .update({ status: record.status, record: JSON.stringify(record) });
+    if (materialized)
+      await (components.wrenEngineAdaptor as LocalDuckdbAdaptor)
+        .dropExplorerSnapshot(snapshotId)
+        .catch((error) => {
+          console.error(
+            'Could not release explorer snapshot',
+            snapshotId,
+            error,
+          );
+        });
+  }
+  return record;
+}
