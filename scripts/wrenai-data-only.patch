+import { Button, Popover } from 'antd';
+import CalendarOutlined from '@ant-design/icons/CalendarOutlined';
+import { ExplorerFilters, ExplorerProfile } from '@/utils/explorer/types';
+
+export default function DateRangeFilter({
+  filters,
+  profile,
+  onChange,
+}: {
+  filters: ExplorerFilters;
+  profile: ExplorerProfile;
+  onChange: (f: ExplorerFilters) => void;
+}) {
+  const summary =
+    filters.from || filters.to
+      ? `${filters.from || 'Start'} – ${filters.to || 'End'}`
+      : profile.dateMin
+        ? `${String(profile.dateMin).slice(0, 4)} – ${String(profile.dateMax).slice(0, 4)} · All dates`
+        : 'All dates';
+  return (
+    <div className="filter-control">
+      <label>
+        <CalendarOutlined /> Date range
+      </label>
+      <Popover
+        trigger="click"
+        placement="bottom"
+        content={
+          <div>
+            <p>Filter by date (inclusive)</p>
+            <div className="date-controls">
+              <input
+                type="date"
+                aria-label="Start date"
+                value={filters.from || ''}
+                max={filters.to || undefined}
+                onChange={(e) =>
+                  onChange({ ...filters, from: e.target.value || undefined })
+                }
+              />
+              <span>–</span>
+              <input
+                type="date"
+                aria-label="End date"
+                value={filters.to || ''}
+                min={filters.from || undefined}
+                onChange={(e) =>
+                  onChange({ ...filters, to: e.target.value || undefined })
+                }
+              />
+            </div>
+            <Button
+              type="link"
+              onClick={() =>
+                onChange({ ...filters, from: undefined, to: undefined })
+              }
+            >
+              All dates
+            </Button>
+          </div>
+        }
+      >
+        <Button
+          type="text"
+          style={{
+            padding: 0,
+            height: 24,
+            textAlign: 'left',
+            width: '100%',
+            overflow: 'hidden',
+            textOverflow: 'ellipsis',
+          }}
+        >
+          {summary}
+        </Button>
+      </Popover>
+    </div>
+  );
+}
diff --git a/wren-ui/src/components/explorer/ExplorerChart.tsx b/wren-ui/src/components/explorer/ExplorerChart.tsx
new file mode 100644
index 00000000..0bc24ee3
--- /dev/null
+++ b/wren-ui/src/components/explorer/ExplorerChart.tsx
@@ -0,0 +1,186 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import dynamic from 'next/dynamic';
+import { Alert, Button, Empty, Skeleton, Table } from 'antd';
+import { TopLevelSpec } from 'vega-lite';
+import {
+  ChartDefinition,
+  ChartResult,
+  ExplorerContext,
+  ExplorerFilters,
+} from '@/utils/explorer/types';
+import { humanize } from '@/utils/explorer/query';
+import { useExplorerResource } from './api';
+
+const Chart = dynamic(() => import('@/components/chart'), { ssr: false });
+export function QueryError({
+  error,
+  retry,
+}: {
+  error: string;
+  retry: () => void;
+}) {
+  return (
+    <Alert
+      type="error"
+      showIcon
+      message={error}
+      action={
+        <Button size="small" onClick={retry}>
+          Retry
+        </Button>
+      }
+    />
+  );
+}
+export function ChartDisplay({
+  chart,
+  result,
+  compact = false,
+}: {
+  chart: ChartDefinition;
+  result: ChartResult;
+  compact?: boolean;
+}) {
+  const container = useRef<HTMLDivElement>();
+  const [width, setWidth] = useState(400);
+  useEffect(() => {
+    const resize = new ResizeObserver((entries) =>
+      setWidth(Math.max(100, entries[0].contentRect.width - 65)),
+    );
+    if (container.current) resize.observe(container.current);
+    return () => resize.disconnect();
+  }, []);
+  const spec = useMemo(() => {
+    const time = chart.kind === 'time';
+    const horizontal = chart.type === 'bar';
+    const group: any = {
+      field: 'label',
+      type: time
+        ? 'temporal'
+        : chart.kind === 'distribution'
+          ? 'quantitative'
+          : 'nominal',
+      title: humanize(chart.groupBy),
+      axis: { labelLimit: 110, grid: time },
+      sort: chart.kind === 'category' ? (horizontal ? '-x' : '-y') : undefined,
+    };
+    const measure: any = {
+      field: 'value',
+      type: 'quantitative',
+      title: result.metricLabel,
+      axis: { format: '~s' },
+    };
+    return {
+      width,
+      height: compact ? 145 : 160,
+      mark: time
+        ? {
+            type: chart.type === 'line' ? 'line' : 'area',
+            line: { color: '#164dff' },
+            color: '#91b5ff',
+            opacity: 0.5,
+            point: { color: '#164dff', filled: true },
+            invalid: 'break-paths-show-domains',
+          }
+        : { type: 'bar', color: '#477dff', cornerRadiusEnd: 2 },
+      encoding: {
+        x: horizontal ? measure : group,
+        y: horizontal ? group : measure,
+        tooltip: [
+          {
+            field: 'label',
+            type: time ? 'temporal' : 'nominal',
+            title: humanize(chart.groupBy),
+          },
+          { ...measure, format: ',.2f' },
+        ],
+      },
+      config: {
+        view: { stroke: null },
+        axis: {
+          labelColor: '#586581',
+          titleColor: '#586581',
+          titleFontWeight: 400,
+        },
+      },
+    } as TopLevelSpec;
+  }, [chart, result.metricLabel, width, compact]);
+  if (!result.values.length)
+    return (
+      <Empty
+        image={Empty.PRESENTED_IMAGE_SIMPLE}
+        description="No data in this scope"
+      />
+    );
+  return (
+    <div ref={container} style={{ minWidth: 0 }}>
+      {chart.type === 'table' ? (
+        <Table
+          size="small"
+          rowKey={(_, i) => String(i)}
+          columns={[
+            { title: humanize(chart.groupBy), dataIndex: 'label' },
+            {
+              title: result.metricLabel,
+              dataIndex: 'value',
+              render: (n) => (n === null ? '—' : Number(n).toLocaleString()),
+            },
+          ]}
+          dataSource={result.values}
+          pagination={{ pageSize: 5, size: 'small' }}
+        />
+      ) : (
+        <Chart
+          spec={spec}
+          values={result.values}
+          width={width + 60}
+          height={compact ? 190 : 215}
+          hideActions
+          hideTitle
+          preserveSpec
+        />
+      )}
+    </div>
+  );
+}
+export default function ExplorerChart({
+  context,
+  filters,
+  chart,
+  draft = false,
+}: {
+  context: ExplorerContext;
+  filters: ExplorerFilters;
+  chart: ChartDefinition;
+  draft?: boolean;
+}) {
+  const resource = useExplorerResource<ChartResult>(
+    { action: 'chart', ref: context, filters, chart },
+    draft ? 350 : 0,
+    !chart.invalidReason,
+  );
+  if (chart.invalidReason)
+    return (
+      <Alert
+        type="warning"
+        message="This chart needs an update"
+        description={chart.invalidReason}
+      />
+    );
+  if (resource.error)
+    return <QueryError error={resource.error} retry={resource.retry} />;
+  if (!resource.data) return <Skeleton active paragraph={{ rows: 4 }} />;
+  return (
+    <>
+      <ChartDisplay chart={chart} result={resource.data} compact={draft} />
+      <p className="explorer-muted chart-caption">
+        {resource.data.metricLabel}
+        {chart.measure === 'item_price'
+          ? ' · Freight excluded · Price units'
+          : ''}{' '}
+        · {resource.data.scope}
+        {chart.kind === 'time' ? ' · Missing periods shown as gaps' : ''}
+      </p>
+    </>
+  );
+}
