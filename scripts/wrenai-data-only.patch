+import { useEffect, useState } from 'react';
+import { Table, Tabs, Tooltip, Typography } from 'antd';
+import { ExplorerContext, ExplorerFilters } from '@/utils/explorer/types';
+import { useExplorerResource } from './api';
+import { QueryError } from './ExplorerChart';
+
+export default function ExplorerTable({
+  context,
+  filters,
+  large = false,
+}: {
+  context: ExplorerContext;
+  filters: ExplorerFilters;
+  large?: boolean;
+}) {
+  const [tab, setTab] = useState('rows');
+  const [page, setPage] = useState(1);
+  const [size, setSize] = useState(large ? 20 : 3);
+  const [sort, setSort] = useState<string>();
+  const [direction, setDirection] = useState('asc');
+  const scope = JSON.stringify([context.datasetId, context.viewId, filters]);
+  useEffect(() => {
+    setPage(1);
+    setSort(undefined);
+  }, [scope]);
+  const resource = useExplorerResource<{
+    rows: Record<string, any>[];
+    total: number;
+  }>({ action: 'rows', ref: context, filters, page, size, sort, direction });
+  return (
+    <section className="explorer-card preview-card">
+      <h3>Data preview</h3>
+      <p className="explorer-muted">
+        Each row represents: {context.rowGrain.toLowerCase()}. Preview pages are
+        a subset of the analysis scope.
+      </p>
+      <Tabs activeKey={tab} onChange={setTab} size="small">
+        <Tabs.TabPane tab="Rows" key="rows">
+          {resource.error ? (
+            <QueryError error={resource.error} retry={resource.retry} />
+          ) : (
+            <Table
+              size="small"
+              loading={resource.loading}
+              scroll={{ x: 'max-content' }}
+              rowKey={(_, i) => `${page}:${i}`}
+              dataSource={resource.data?.rows || []}
+              columns={context.fields.map((f) => ({
+                title: f.label,
+                dataIndex: f.name,
+                width: f.role === 'identifier' ? 150 : 160,
+                sorter: true,
+                sortOrder:
+                  sort === f.name
+                    ? direction === 'asc'
+                      ? 'ascend'
+                      : 'descend'
+                    : undefined,
+                render: (value) => {
+                  if (value === null || value === undefined)
+                    return (
+                      <Tooltip title="Null">
+                        <span style={{ color: '#7f8aa5' }}>—</span>
+                      </Tooltip>
+                    );
+                  if (f.role === 'number')
+                    return Number(value).toLocaleString(undefined, {
+                      maximumFractionDigits: 2,
+                    });
+                  if (f.role === 'date')
+                    return (
+                      <Tooltip title={String(value)}>
+                        {String(value).slice(0, 10)}
+                      </Tooltip>
+                    );
+                  if (f.role === 'identifier')
+                    return (
+                      <Tooltip title={String(value)}>
+                        <Typography.Text
+                          copyable={{
+                            text: String(value),
+                            tooltips: ['Copy full value', 'Copied'],
+                          }}
+                        >
+                          {String(value).length > 12
+                            ? `${String(value).slice(0, 8)}…`
+                            : String(value)}
+                        </Typography.Text>
+                      </Tooltip>
+                    );
+                  return (
+                    <Tooltip title={String(value)}>
+                      <span>
+                        {String(value).length > 60
+                          ? `${String(value).slice(0, 60)}…`
+                          : String(value)}
+                      </span>
+                    </Tooltip>
+                  );
+                },
+              }))}
+              pagination={{
+                current: page,
+                pageSize: size,
+                total: resource.data?.total || 0,
+                showSizeChanger: large,
+                pageSizeOptions: ['10', '20', '50', '100'],
+                showTotal: (total) => `${total.toLocaleString()} matching rows`,
+              }}
+              onChange={(pagination, _, sorter: any) => {
+                setPage(pagination.current);
+                setSize(pagination.pageSize);
+                setSort(sorter.order ? sorter.field : undefined);
+                setDirection(sorter.order === 'descend' ? 'desc' : 'asc');
+              }}
+            />
+          )}
+        </Tabs.TabPane>
+        <Tabs.TabPane tab="Fields" key="fields">
+          <Table
+            size="small"
+            rowKey="name"
+            dataSource={context.fields}
+            pagination={false}
+            scroll={{ x: 600 }}
+            columns={[
+              { title: 'Field', dataIndex: 'name' },
+              { title: 'Type', dataIndex: 'type' },
+              { title: 'Role', dataIndex: 'role' },
+              {
+                title: 'Description',
+                dataIndex: 'description',
+                render: (d) => d || 'Not defined',
+              },
+            ]}
+          />
+        </Tabs.TabPane>
+      </Tabs>
+    </section>
+  );
+}
