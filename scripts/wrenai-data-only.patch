+import type { NextApiRequest, NextApiResponse } from 'next';
+import { mkdir, writeFile, unlink } from 'node:fs/promises';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { components, serverConfig } from '@/common';
+import { LocalDuckdbAdaptor } from '@/apollo/server/adaptors/localDuckdbAdaptor';
+import { explorerService } from '@/apollo/server/services/explorerService';
+import { fieldRole, humanize } from '@/utils/explorer/query';
+
+export const config = { api: { bodyParser: false } };
+
+export default async function handler(
+  req: NextApiRequest,
+  res: NextApiResponse,
+) {
+  res.setHeader('Cache-Control', 'no-store');
+  if (req.method !== 'POST')
+    return res.status(405).json({ error: 'Method not allowed' });
+  let file: string;
+  try {
+    if (!serverConfig.dataOnlyMode)
+      throw new Error(
+        'CSV import is available with the local DuckDB connection. Use WrenAI connection settings for other sources.',
+      );
+    const project = await explorerService.project();
+    const name = String(req.query.name || '').trim();
+    const grain =
+      String(req.query.grain || 'Not defined').trim() || 'Not defined';
+    if (!name || name.length > 120 || grain.length > 150)
+      throw new Error('Provide a dataset name of at most 120 characters');
+    const parts: Buffer[] = [];
+    let bytes = 0;
+    for await (const part of req) {
+      bytes += part.length;
+      if (bytes > 20 * 1024 * 1024)
+        throw new Error('CSV files must be smaller than 20 MB');
+      parts.push(Buffer.from(part));
+    }
+    if (!bytes || !Buffer.concat(parts).toString('utf8').trim())
+      throw new Error('The CSV file is empty');
+    const id = randomUUID();
+    const physicalTable = `upload_${id.replace(/-/g, '')}`;
+    const directory = path.join(
+      path.dirname(serverConfig.localDuckdbFile),
+      'uploads',
+    );
+    await mkdir(directory, { recursive: true });
+    file = path.join(directory, `${id}.csv`);
+    await writeFile(file, Buffer.concat(parts), { flag: 'wx' });
+    const adapter = components.wrenEngineAdaptor as LocalDuckdbAdaptor;
+    const metadata = await adapter.importExplorerCsv(file, physicalTable);
+    const fields = metadata.columns.map((f) => ({
+      ...f,
+      label: humanize(f.name),
+      role: fieldRole(f.name, f.type),
+    }));
+    await components.knex('explorer_dataset').insert({
+      id,
+      project_id: project.id,
+      name,
+      physical_table: physicalTable,
+      fields: JSON.stringify(fields),
+      row_grain: grain,
+      created_at: new Date().toISOString(),
+    });
+    return res.status(201).json({ datasetId: id, viewId: 'table' });
+  } catch (error) {
+    return res
+      .status(400)
+      .json({ error: error.message || 'CSV could not be imported' });
+  } finally {
+    if (file) await unlink(file).catch(() => undefined);
+  }
+}
