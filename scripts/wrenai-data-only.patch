+import { scopedRequest } from './scopedRequest';
+
+it('does not put a previous dataset response into the next dataset workspace', async () => {
+  let finishOld: (value: string) => void;
+  let finishNew: (value: string) => void;
+  const rendered: string[] = [];
+  const failures: Error[] = [];
+  const old = scopedRequest(
+    () =>
+      new Promise<string>((resolve) => {
+        finishOld = resolve;
+      }),
+    (value) => rendered.push(value),
+    (error) => failures.push(error),
+  );
+  old.cancel();
+  const next = scopedRequest(
+    () =>
+      new Promise<string>((resolve) => {
+        finishNew = resolve;
+      }),
+    (value) => rendered.push(value),
+    (error) => failures.push(error),
+  );
+  finishNew('new dataset');
+  await next.done;
+  finishOld('old dataset');
+  await old.done;
+  expect(rendered).toEqual(['new dataset']);
+  expect(failures).toEqual([]);
+});
