@@ -0,0 +1,113 @@
+import {
+  ChartDefinition,
+  ExplorerContext,
+  ExplorerFilters,
+  ExplorerProfile,
+  ExplorerRef,
+} from '../explorer/types';
+
+export type AnalysisTask =
+  | 'exploration'
+  | 'clustering'
+  | 'classification'
+  | 'regression';
+export type TargetSource = 'manual' | 'saved' | 'metadata' | 'goal';
+export type DatasetScope = {
+  ref: ExplorerRef;
+  filters: ExplorerFilters;
+  datasetVersion: string;
+  sourceVersion?: string;
+};
+export interface AnalysisDraft {
+  task: AnalysisTask;
+  goal: string;
+  goalEditedByUser: boolean;
+  target?: string;
+  targetSource?: TargetSource;
+  featureMode: 'auto' | 'select';
+  features: string[];
+  evaluation: 'automatic' | 'separate';
+  test?: DatasetScope;
+  split: 'auto' | 'random' | 'group' | 'time';
+  groupColumn?: string;
+  clusters?: number;
+  includeCharts: boolean;
+}
+export interface RunInput extends DatasetScope {
+  id: string;
+  task: AnalysisTask;
+  goal: string;
+  charts?: ChartDefinition[];
+  config: {
+    includeCharts?: boolean;
+    features?: string[];
+    clusters?: number;
+    target?: string;
+    evaluation?: 'automatic' | 'separate';
+    test?: DatasetScope;
+    split?: AnalysisDraft['split'];
+    groupColumn?: string;
+  };
+}
+export interface ReportVisual {
+  id: string;
+  title: string;
+  kind: 'chartSpec' | 'image';
+  caption: string;
+  altText: string;
+  chartSpec?: Record<string, any>;
+  imageRef?: string;
+}
+export interface AnalysisReport {
+  runId: string;
+  task: AnalysisTask;
+  status: 'running' | 'completed' | 'failed';
+  createdAt: string;
+  goal: string;
+  context: ExplorerContext;
+  scope: DatasetScope & {
+    rowCount: number;
+    snapshotId: string;
+    test?: DatasetScope & { rowCount: number; snapshotId: string };
+    metricDefinitions: string[];
+    rowGrain: string;
+  };
+  summary: string[];
+  insights?: {
+    id: string;
+    title: string;
+    detail: string;
+    evidenceIds: string[];
+  }[];
+  findings: {
+    id: string;
+    title: string;
+    interpretation: string;
+    evidenceIds: string[];
+  }[];
+  visuals: ReportVisual[];
+  metrics: { label: string; value: number | string | null }[];
+  nextSteps: string[];
+  limitations: string[];
+  evaluation?: Record<string, any>;
+  error?: string;
+}
+export interface RunRecord {
+  id: string;
+  status: AnalysisReport['status'];
+  createdAt: string;
+  context: ExplorerContext;
+  goal: string;
+  input: RunInput;
+  report: AnalysisReport;
+  stage?: string;
+  error?: string;
+}
+export interface SetupData {
+  context: ExplorerContext;
+  profile: ExplorerProfile;
+  catalog: { datasets: { id: string; name: string }[] };
