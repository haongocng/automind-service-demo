@@ -0,0 +1,69 @@
+import type { NextApiRequest, NextApiResponse } from 'next';
+import { components } from '@/common';
+import { explorerService } from '@/apollo/server/services/explorerService';
+import { runExplorerAnalysis } from '@/apollo/server/services/explorerAutoMindAdapter';
+import {
+  getAnalysis,
+  runAnalysis,
+  saveAnalysisDraft,
+  setupAnalysis,
+} from '@/apollo/server/services/analysisService';
+
+export default async function handler(
+  req: NextApiRequest,
+  res: NextApiResponse,
+) {
+  res.setHeader('Cache-Control', 'no-store');
+  try {
+    if (req.method === 'GET') {
+      if (req.query.action === 'analyses') {
+        const project = await explorerService.project();
+        const records = await components
+          .knex('explorer_analysis')
+          .where({ project_id: project.id })
+          .orderBy('created_at', 'desc')
+          .limit(100);
+        return res.json({ analyses: records.map((r) => JSON.parse(r.record)) });
+      }
+      return res.json(await explorerService.catalog());
+    }
+    if (req.method !== 'POST')
+      return res.status(405).json({ error: 'Method not allowed' });
+    const { action, ref, filters, chart, charts, page, size, sort, direction } =
+      req.body;
+    if (action === 'analysis.setup')
+      return res.json(
+        await setupAnalysis(ref || {}, req.body.fromRun, req.body.filters),
+      );
+    if (action === 'analysis.draft')
+      return res.json(await saveAnalysisDraft(ref, req.body.draft));
+    if (action === 'analysis.run')
+      return res.json(await runAnalysis(req.body.input));
+    if (action === 'analysis.record')
+      return res.json(await getAnalysis(req.body.id));
+    if (action === 'context')
+      return res.json(await explorerService.context(ref || {}));
+    if (action === 'rows')
+      return res.json(
+        await explorerService.rows(ref, filters, page, size, sort, direction),
+      );
+    if (action === 'chart')
+      return res.json(
+        await explorerService.chart(
+          await explorerService.prepare(ref, filters),
+          filters,
+          chart,
+        ),
+      );
+    if (action === 'save')
+      return res.json(await explorerService.save(ref, filters, charts));
+    if (action === 'analyze')
+      return res.json(await runExplorerAnalysis(req.body));
+    return res.status(400).json({ error: 'Unknown explorer action' });
+  } catch (error) {
+    console.error('Explorer request failed:', error.message);
+    return res
+      .status(400)
+      .json({ error: error.message || 'Explorer request failed' });
+  }
+}
