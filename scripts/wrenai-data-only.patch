new file mode 100644
index 00000000..39ce342d
--- /dev/null
+++ b/wren-ui/src/components/explorer/scopedRequest.ts
@@ -0,0 +1,23 @@
+/** Cancel also rejects late results from transports that ignore AbortSignal. */
+export function scopedRequest<T>(
+  request: (signal: AbortSignal) => Promise<T>,
+  apply: (data: T) => void,
+  fail: (error: Error) => void,
+) {
+  const controller = new AbortController();
+  let active = true;
+  const done = request(controller.signal)
+    .then((data) => {
+      if (active) apply(data);
+    })
+    .catch((error) => {
+      if (active && error.name !== 'AbortError') fail(error);
+    });
+  return {
+    done,
+    cancel: () => {
+      active = false;
+      controller.abort();
+    },
+  };
+}
