diff --git a/wren-ui/src/apollo/server/adaptors/localDuckdbAdaptor.ts b/wren-ui/src/apollo/server/adaptors/localDuckdbAdaptor.ts
new file mode 100644
index 00000000..bc73fb95
--- /dev/null
+++ b/wren-ui/src/apollo/server/adaptors/localDuckdbAdaptor.ts
@@ -0,0 +1,287 @@
+import { access, mkdir } from 'node:fs/promises';
+import path from 'node:path';
+import { Database } from 'duckdb-async';
+import type { Manifest } from '../mdl/type';
+import type { CompactTable } from '../services/metadataService';
+import type {
+  DuckDBPrepareOptions,
+  DryPlanOption,
+  EngineQueryResponse,
+  IWrenEngineAdaptor,
+  WrenEngineDryRunOption,
+} from './wrenEngineAdaptor';
+
+const quoteIdentifier = (value: string) => `"${value.replace(/"/g, '""')}"`;
+const quoteString = (value: string) => `'${value.replace(/'/g, "''")}'`;
+
+// Next.js dev reloads API modules. Keep one native database handle per process.
+const runtime = globalThis as typeof globalThis & {
+  wrenLocalDuckdb?: { file: string; database: Promise<Database> };
+};
+
+/**
+ * Opt-in local adapter for sample tables, explicit SQL joins and basic MDL aliases.
+ * It does not implement Wren's relationship traversal or calculated aggregates.
+ * The regular remote Wren Engine adapter remains the default outside data mode.
+ */
+export class LocalDuckdbAdaptor implements IWrenEngineAdaptor {
+  constructor(
+    private readonly file: string,
+    private readonly sampleDataDir: string,
+  ) {}
+
+  private database(): Promise<Database> {
+    const file = path.resolve(this.file);
+    if (runtime.wrenLocalDuckdb && runtime.wrenLocalDuckdb.file !== file) {
+      throw new Error('Restart the frontend before changing WREN_DUCKDB_FILE');
+    }
+    if (!runtime.wrenLocalDuckdb) {
+      const database = (async () => {
+        await mkdir(path.dirname(file), { recursive: true });
+        return Database.create(file, { threads: '2', memory_limit: '512MB' });
+      })();
+      runtime.wrenLocalDuckdb = { file, database };
+      database.catch(() => {
+        if (runtime.wrenLocalDuckdb?.database === database) {
+          delete runtime.wrenLocalDuckdb;
+        }
+      });
+    }
+    return runtime.wrenLocalDuckdb.database;
+  }
+
+  public async prepareDuckDB({ initSql, sessionProps }: DuckDBPrepareOptions) {
+    // Read the cached original assets without an httpfs extension or network call.
+    let sql = initSql;
+    const urls = new Set(
+      sql.match(
+        /https:\/\/assets\.getwren\.ai\/sample_data\/brazilian-ecommerce\/[a-z_]+\.parquet/g,
+      ) || [],
+    );
+    for (const url of urls) {
+      const localFile = path.resolve(this.sampleDataDir, path.basename(url));
+      await access(localFile);
+      sql = sql.split(quoteString(url)).join(quoteString(localFile));
+    }
+    if (/https?:\/\//i.test(sql)) {
+      throw new Error(
+        'Data mode supports cached E-commerce files and local files. Other remote sources require the regular Wren stack.',
+      );
+    }
+    const db = await this.database();
+    await this.putSessionProps(sessionProps);
+    const connection = await db.connect();
+    try {
+      await connection.exec('BEGIN TRANSACTION');
+      const tables = await connection.all(
+        "SELECT table_name FROM information_schema.tables WHERE table_schema = 'main' AND table_type = 'BASE TABLE'",
+      );
+      for (const table of tables) {
+        await connection.exec(
+          `DROP TABLE main.${quoteIdentifier(table.table_name)}`,
+        );
+      }
+      await connection.exec(sql);
+      await connection.exec('COMMIT');
+    } catch (error) {
+      await connection.exec('ROLLBACK');
+      throw error;
+    } finally {
+      await connection.close();
+    }
+    await db.exec('CHECKPOINT');
+  }
+
+  public async putSessionProps(props: Record<string, any>) {
+    const db = await this.database();
+    for (const [name, value] of Object.entries(props)) {
+      await db.exec(
+        `SET ${quoteIdentifier(name)} = ${quoteString(String(value))}`,
+      );
+    }
+  }
+
+  public async queryDuckdb(sql: string): Promise<EngineQueryResponse> {
+    const db = await this.database();
+    const statement = sql.trim().replace(/;+\s*$/, '');
+    const metadata = await db.all(`DESCRIBE ${statement}`);
+    const columns = metadata.map((column) => ({
+      name: column.column_name as string,
+      type: column.column_type as string,
+    }));
+    const rows = await db.all(statement);
+    return {
+      columns,
+      data: rows.map((row) =>
+        columns.map(({ name }) => this.jsonValue(row[name])),
+      ),
+    };
+  }
+
+  /** Owned CSV tables live outside main: importing never replaces connected data. */
+  public async importExplorerCsv(file: string, name: string) {
+    if (!/^upload_[a-f0-9]{32}$/.test(name))
+      throw new Error('Invalid upload table');
+    const db = await this.database();
+    await db.exec('CREATE SCHEMA IF NOT EXISTS explorer_uploads');
+    await db.exec(
+      `CREATE TABLE explorer_uploads.${quoteIdentifier(name)} AS SELECT * FROM read_csv_auto(${quoteString(file)}, header = true, sample_size = -1)`,
+    );
+    return this.queryDuckdb(
+      `SELECT * FROM explorer_uploads.${quoteIdentifier(name)} LIMIT 0`,
+    );
+  }
+
+  public async createExplorerSnapshot(
+    name: string,
+    sql: string,
+    manifest: Manifest,
+  ) {
+    if (!/^snapshot_[a-f0-9]{32}$/.test(name))
+      throw new Error('Invalid snapshot table');
+    const db = await this.database();
+    const nativeSql = await this.getNativeSQL(sql, { manifest });
+    await db.exec('CREATE SCHEMA IF NOT EXISTS explorer_snapshots');
+    await db.exec(
+      `CREATE TABLE explorer_snapshots.${quoteIdentifier(name)} AS ${nativeSql}`,
+    );
+    return `SELECT * FROM explorer_snapshots.${quoteIdentifier(name)}`;
+  }
+
+  public async dropExplorerSnapshot(name: string) {
+    if (!/^snapshot_[a-f0-9]{32}$/.test(name))
+      throw new Error('Invalid snapshot table');
+    const db = await this.database();
+    await db.exec(
+      `DROP TABLE IF EXISTS explorer_snapshots.${quoteIdentifier(name)}`,
+    );
+  }
+
+  private jsonValue(value: any): any {
+    if (typeof value === 'bigint') {
+      const number = Number(value);
+      return Number.isSafeInteger(number) ? number : value.toString();
+    }
+    if (value instanceof Date) return value.toISOString();
+    if (Array.isArray(value)) return value.map((item) => this.jsonValue(item));
+    if (Buffer.isBuffer(value)) return value.toString('base64');
+    if (value !== null && typeof value === 'object') {
+      return Object.fromEntries(
+        Object.entries(value).map(([key, item]) => [key, this.jsonValue(item)]),
+      );
+    }
+    return value;
+  }
+
+  public async listTables(): Promise<CompactTable[]> {
+    const db = await this.database();
+    const columns = await db.all(`
+      SELECT table_catalog, table_schema, table_name, column_name, is_nullable, data_type
+      FROM information_schema.columns
+      WHERE table_schema = 'main'
+      ORDER BY table_name, ordinal_position
+    `);
+    const tables = new Map<string, CompactTable>();
+    for (const column of columns) {
+      const name = column.table_name as string;
+      if (!tables.has(name)) {
+        tables.set(name, {
+          name,
+          description: '',
+          columns: [],
+          properties: {
+            catalog: column.table_catalog,
+            schema: column.table_schema,
+            table: name,
+          },
+          primaryKey: null,
+        });
+      }
+      tables.get(name).columns.push({
+        name: column.column_name,
+        type: column.data_type,
+        notNull: column.is_nullable !== 'YES',
+        description: '',
+        properties: {},
+      });
+    }
+    return [...tables.values()];
+  }
+
+  public async patchConfig(config: Record<string, any>) {
+    if (config['wren.datasource.type'] !== 'duckdb') {
+      throw new Error('Data mode supports DuckDB only');
+    }
+  }
+
+  public async getNativeSQL(sql: string, options?: DryPlanOption) {
+    const manifest = options?.manifest;
+    const ctes = (manifest?.models || []).map((model) => {
+      if (model.columns?.some((column) => column.isCalculated)) {
+        throw new Error(
+          'Calculated fields require the regular Wren Engine. Data mode supports basic columns and explicit SQL joins.',
+        );
+      }
+      const reference = model.tableReference;
+      // Qualify physical tables to avoid recursively resolving the model's CTE.
+      const source = reference
+        ? [reference.catalog, reference.schema || 'main', reference.table]
+            .filter(Boolean)
+            .map(quoteIdentifier)
+            .join('.')
+        : model.refSql
+          ? `(${model.refSql})`
+          : undefined;
+      if (!source) throw new Error(`No source table for model ${model.name}`);
+      const columns = (model.columns || [])
+        .filter((column) => !column.relationship)
+        .map(
+          (column) =>
+            `${column.expression || quoteIdentifier(column.name)} AS ${quoteIdentifier(column.name)}`,
+        );
+      return `${quoteIdentifier(model.name)} AS (SELECT ${columns.join(', ') || '*'} FROM ${source})`;
+    });
+    for (const view of manifest?.views || []) {
+      ctes.push(`${quoteIdentifier(view.name)} AS (${view.statement})`);
+    }
+    const statement = sql.trim().replace(/;+\s*$/, '');
+    return `${ctes.length ? `WITH ${ctes.join(', ')} ` : ''}SELECT * FROM (${statement}) AS _wren_data_query`;
+  }
+
+  public async previewData(sql: string, manifest: Manifest, limit = 500) {
+    const nativeSql = await this.getNativeSQL(sql, { manifest });
+    const rowLimit = Number.isFinite(limit)
+      ? Math.max(0, Math.floor(limit))
+      : 500;
+    return this.queryDuckdb(`${nativeSql} LIMIT ${rowLimit}`);
+  }
+
+  public async dryRun(sql: string, options: WrenEngineDryRunOption) {
+    const db = await this.database();
+    const nativeSql = await this.getNativeSQL(sql, options);
+    const columns = await db.all(`DESCRIBE ${nativeSql}`);
+    return columns.map((column) => ({
+      name: column.column_name,
+      type: column.column_type,
+    }));
+  }
+
+  public async validateColumnIsValid(
+    manifest: Manifest,
+    modelName: string,
+    columnName: string,
+  ) {
+    try {
+      await this.dryRun(
+        `SELECT ${quoteIdentifier(columnName)} FROM ${quoteIdentifier(modelName)}`,
+        { manifest },
+      );
+      return { valid: true };
+    } catch (error) {
+      return {
+        valid: false,
+        message: error instanceof Error ? error.message : String(error),
+      };
+    }
+  }
+}
diff --git a/wren-ui/src/apollo/server/services/analysisService.ts b/wren-ui/src/apollo/server/services/analysisService.ts
new file mode 100644
index 00000000..57119d3d
--- /dev/null
+++ b/wren-ui/src/apollo/server/services/analysisService.ts
@@ -0,0 +1,608 @@
+import { components, serverConfig } from '@/common';
+import { LocalDuckdbAdaptor } from '../adaptors/localDuckdbAdaptor';
+import { explorerService, hash } from './explorerService';
+import { filteredSQL, validateChart } from '@/utils/explorer/query';
+import {
+  AnalysisDraft,
+  AnalysisReport,
+  AnalysisTask,
+  ReportVisual,
+  RunInput,
+  RunRecord,
+  SetupData,
+} from '@/utils/analysis/types';
+import {
+  draftFromRun,
+  resolveDraft,
+  supervised,
+} from '@/utils/analysis/config';
+import {
+  AnalysisRecord,
+  ExplorerFilters,
+  ExplorerRef,
+} from '@/utils/explorer/types';
+
+const tasks: AnalysisTask[] = [
+  'exploration',
+  'clustering',
+  'classification',
+  'regression',
+];
+const endpoint = (path: string) =>
+  `${process.env.AUTOMIND_ANALYSIS_BASE_URL || 'http://127.0.0.1:8000'}/analyze/${path}`;
+const refKey = (ref: ExplorerRef, task: AnalysisTask) =>
+  hash([ref.projectId, ref.datasetId, ref.viewId, task]);
+
+async function service(path: string, body?: unknown) {
+  const response = await fetch(endpoint(path), {
+    method: body ? 'POST' : 'GET',
+    headers: { 'Content-Type': 'application/json' },
+    body: body ? JSON.stringify(body) : undefined,
+    signal: AbortSignal.timeout(body ? 180000 : 5000),
+  });
+  const result = await response.json();
+  if (!response.ok)
+    throw new Error(
+      typeof result.detail === 'string'
+        ? result.detail
+        : `Analysis service returned ${response.status}. Check its validation response.`,
+    );
+  return result;
+}
+
+export async function setupAnalysis(
+  ref: Partial<ExplorerRef>,
+  fromRun?: string,
+  filters?: ExplorerFilters,
+): Promise<SetupData> {
+  let old: RunRecord;
+  if (fromRun) old = await getAnalysis(fromRun);
+  const resource = await explorerService.context(
+    old?.input?.ref ? { ...old.input.ref, schemaVersion: undefined } : ref,
+  );
+  if (old?.input) resource.context.filters = old.input.filters;
+  else if (filters) resource.context.filters = filters;
+  const loaded = await explorerService.prepare(
+    resource.context,
+    resource.context.filters,
+  );
+  const profile = await explorerService.profile(
+    loaded,
+    resource.context.filters,
+  );
+  const rows = await components.knex('explorer_analysis_draft').where({
+    // Draft keys use the context; versions are revalidated separately at Run.
+    project_id: resource.context.projectId,
+    dataset_id: resource.context.datasetId,
+    view_id: resource.context.viewId,
+  });
+  const drafts: SetupData['drafts'] = {};
+  profile.sourceVersion = resource.profile.datasetVersion;
+  for (const row of rows) {
+    const draft = JSON.parse(row.draft) as AnalysisDraft;
+    if (draft.targetSource === 'manual') draft.targetSource = 'saved';
+    drafts[row.task] = resolveDraft(draft, resource.context, profile).draft;
+  }
+  if (old?.input)
+    drafts[old.input.task] = draftFromRun(old.input, resource.context);
+  let capabilities: SetupData['capabilities'];
+  try {
+    capabilities = await service('capabilities');
+  } catch {
+    capabilities = Object.fromEntries(tasks.map((t) => [t, false]));
+  }
+  return {
+    context: resource.context,
+    profile,
+    drafts,
+    capabilities,
+    catalog: await explorerService.catalog(),
+    restoredTask: old?.input?.task,
+  };
+}
+
+export async function saveAnalysisDraft(
+  ref: ExplorerRef,
+  draft: AnalysisDraft,
+) {
+  if (
+    !tasks.includes(draft.task) ||
+    typeof draft.goal !== 'string' ||
+    draft.goal.length > 2000 ||
+    !Array.isArray(draft.features)
+  )
+    throw new Error('Invalid analysis draft');
+  const loaded = await explorerService.load(ref);
+  const row = {
+    key: refKey(loaded.ctx, draft.task),
+    project_id: loaded.ctx.projectId,
+    dataset_id: loaded.ctx.datasetId,
+    view_id: loaded.ctx.viewId,
+    task: draft.task,
+    schema_version: loaded.ctx.schemaVersion,
+    draft: JSON.stringify(draft),
+    updated_at: new Date().toISOString(),
+  };
+  await components
+    .knex('explorer_analysis_draft')
+    .insert(row)
+    .onConflict('key')
+    .merge();
+  return { saved: true };
+}
+
+function evidenceVisual(e: any, i: number): ReportVisual {
+  const time = e.chart?.kind === 'time';
+  return {
+    id: `evidence-${i}`,
+    title: e.title,
+    kind: 'chartSpec',
+    caption: `${e.metricLabel || e.title}. ${e.scope || 'Selected analysis scope'}. ${time ? 'Periods without observations remain gaps.' : 'Only the configured categories are displayed.'}`,
+    altText: e.title,
+    chartSpec: {
+      data: { values: e.values },
+      mark: time
+        ? {
+            type: 'line',
+            color: '#164dff',
+            point: true,
+            invalid: 'break-paths-show-domains',
+          }
+        : { type: 'bar', color: '#477dff' },
+      encoding: time
+        ? {
+            x: { field: 'label', type: 'temporal', title: 'Period' },
+            y: {
+              field: 'value',
+              type: 'quantitative',
+              title: e.metricLabel || 'Value',
+            },
+            tooltip: [
+              { field: 'label', type: 'temporal' },
+              { field: 'value', type: 'quantitative' },
+            ],
+          }
+        : {
+            x: {
+              field: 'value',
+              type: 'quantitative',
+              title: e.metricLabel || 'Value',
+            },
+            y: { field: 'label', type: 'nominal', sort: '-x', title: null },
+            tooltip: [
+              { field: 'label' },
+              { field: 'value', type: 'quantitative' },
+            ],
+          },
+    },
+  };
+}
+export function normalizeLegacy(record: AnalysisRecord): RunRecord {
+  const evidence = record.result?.evidence || [];
+  const input: RunInput = {
+    id: record.id,
+    ref: record.context,
+    filters: record.filters,
+    datasetVersion: String(
+      record.result?.technical?.datasetVersion || 'Legacy snapshot',
+    ),
+    task: 'exploration',
+    goal: record.goal,
+    charts: record.context.charts,
+    config: { includeCharts: true },
+  };
+  const report: AnalysisReport = {
+    runId: record.id,
+    status: record.status,
+    task: 'exploration',
+    createdAt: record.createdAt,
+    goal: record.goal,
+    context: record.context,
+    scope: {
+      ref: record.context,
+      filters: record.filters,
+      datasetVersion: input.datasetVersion,
+      snapshotId: record.snapshotId,
+      rowCount: Number(record.result?.technical?.rowCount || 0),
+      rowGrain: record.context.rowGrain,
+      metricDefinitions: record.context.metricDefinitions,
+    },
+    summary: record.result?.summary || [],
+    insights: record.result?.insights,
+    findings:
+      record.result?.findings ||
+      evidence.map((e, i) => ({
+        id: `finding-${i}`,
+        title: e.title,
+        interpretation: `${e.title} compares the observed values in this saved scope. Review the displayed groups and dates before comparing totals.`,
+        evidenceIds: [`evidence-${i}`],
+      })),
+    visuals: evidence.map(evidenceVisual),
+    metrics: [],
+    nextSteps: record.result?.nextChecks || [],
+    limitations: record.result?.limitations || [
+      'The comparisons describe the selected records and filters. They do not establish causes or predict future activity.',
+    ],
+    error: record.error,
+  };
+  return { ...record, input, report };
+}
+export async function getAnalysis(id: string): Promise<RunRecord> {
+  const project = await explorerService.project();
+  const row = await components
+    .knex('explorer_analysis')
+    .where({ id, project_id: project.id })
+    .first();
+  if (!row) throw new Error('Analysis is not available in this project.');
+  const record = JSON.parse(row.record);
+  return record.report ? record : normalizeLegacy(record);
+}
+
+export async function runAnalysis(input: RunInput): Promise<RunRecord> {
+  if (
+    !/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(
+      input.id,
+    ) ||
+    !tasks.includes(input.task) ||
+    !input.goal?.trim() ||
+    input.goal.length > 2000
+  )
+    throw new Error('A valid run ID, task and goal are required.');
+  const project = await explorerService.project(input.ref.projectId);
+  const requestHash = hash(input);
+  const prior = await components
+    .knex('explorer_analysis')
+    .where({ id: input.id, project_id: project.id })
+    .first();
+  if (prior) {
+    if (prior.request_hash !== requestHash)
+      throw new Error('This run ID already belongs to another request.');
+    return JSON.parse(prior.record);
+  }
+  const allowed =
+    input.task === 'exploration'
+      ? ['includeCharts']
+      : input.task === 'clustering'
+        ? ['features', 'clusters']
+        : ['target', 'features', 'evaluation', 'test', 'split', 'groupColumn'];
+  if (
+    !input.config ||
+    Object.keys(input.config).some((key) => !allowed.includes(key))
+  )
+    throw new Error('Request contains configuration for another task.');
+  const { context } = await explorerService.context(input.ref);
+  context.filters = input.filters;
+  const loaded = await explorerService.prepare(input.ref, input.filters);
+  const profile = await explorerService.profile(loaded, input.filters);
+  if (profile.datasetVersion !== input.datasetVersion)
+    throw new Error(
+      'Data changed since setup was opened. Reload setup to revalidate your settings.',
+    );
+  const sourceProfile = await explorerService.profile(loaded);
+  if (
+    !input.sourceVersion ||
+    input.sourceVersion !== sourceProfile.datasetVersion
+  )
+    throw new Error(
+      'The source data changed since setup was opened. Reload setup to revalidate all chart scopes.',
+    );
+  if (!profile.rowCount)
+    throw new Error('No data is available in the selected scope.');
+  const capability = await service('capabilities');
+  if (!capability[input.task])
+    throw new Error('This task is not connected yet.');
+  const config = input.config;
+  if (supervised(input.task)) {
+    const resolved = resolveDraft(
+      {
+        task: input.task,
+        goal: input.goal,
+        goalEditedByUser: true,
+        target: config.target,
+        targetSource: 'manual',
+        features: config.features || [],
+        featureMode: config.features ? 'select' : 'auto',
+        evaluation: config.evaluation,
+        split: config.split || 'auto',
+        includeCharts: false,
+      },
+      context,
+      profile,
+    );
+    if (resolved.issue) throw new Error(resolved.issue);
+    if (!['automatic', 'separate'].includes(config.evaluation))
+      throw new Error('Choose a supported evaluation setup.');
+    if (config.evaluation === 'automatic' && config.test)
+      throw new Error('Automatic split does not use a separate test dataset.');
+  }
+  let testLoaded: Awaited<ReturnType<typeof explorerService.prepare>>;
+  let testProfile: typeof profile;
+  if (supervised(input.task) && config.evaluation === 'separate') {
+    if (!config.test)
+      throw new Error('Choose an independent labelled test dataset.');
+    if (config.test.ref.datasetId === input.ref.datasetId)
+      throw new Error('Training and test must be independent datasets.');
+    testLoaded = await explorerService.prepare(
+      config.test.ref,
+      config.test.filters,
+    );
+    testProfile = await explorerService.profile(
+      testLoaded,
+      config.test.filters,
+    );
+    if (config.test.datasetVersion !== testProfile.datasetVersion)
+      throw new Error('Test data changed. Select it again to revalidate.');
+    if (
+      config.test.sourceVersion &&
+      config.test.sourceVersion !==
+        (await explorerService.profile(testLoaded)).datasetVersion
+    )
+      throw new Error(
+        'The test source changed. Select it again to revalidate.',
+      );
+    if (!testLoaded.ctx.fields.some((f) => f.name === config.target))
+      throw new Error(
+        `The test dataset has no '${config.target}' labels. It can support inference but cannot measure model quality. Use Automatic split or a labelled test dataset.`,
+      );
+  }
+  const definitions =
+    input.task === 'exploration' && config.includeCharts
+      ? input.charts || []
+      : [];
+  if (!Array.isArray(definitions) || definitions.length > 10)
+    throw new Error('Invalid chart definitions.');
+  definitions.forEach((d) => validateChart(context.fields, d));
+  context.charts = definitions;
+  const snapshotId = `snapshot_${input.id.replace(/-/g, '')}`;
+  const testSnapshot = `snapshot_${hash(input.id).slice(0, 32)}`;
+  const createdAt = new Date().toISOString();
+  const record: RunRecord = {
+    id: input.id,
+    status: 'running',
+    createdAt,
+    context,
+    goal: input.goal,
+    input,
+    stage: 'Preparing frozen data',
+    report: {
+      runId: input.id,
+      task: input.task,
+      status: 'running',
+      createdAt,
+      goal: input.goal,
+      context,
+      scope: {
+        ref: input.ref,
+        filters: input.filters,
+        datasetVersion: profile.datasetVersion,
+        sourceVersion: input.sourceVersion,
+        rowCount: profile.rowCount,
+        snapshotId,
+        rowGrain: context.rowGrain,
+        metricDefinitions: context.metricDefinitions,
+        test: testProfile
+          ? {
+              ...config.test,
+              rowCount: testProfile.rowCount,
+              snapshotId: testSnapshot,
+            }
+          : undefined,
+      },
+      summary: [],
+      findings: [],
+      visuals: [],
+      metrics: [],
+      nextSteps: [],
+      limitations: [],
+    },
+  };
+  try {
+    await components.knex('explorer_analysis').insert({
+      id: input.id,
+      project_id: project.id,
+      request_hash: requestHash,
+      status: 'running',
+      record: JSON.stringify(record),
+      created_at: createdAt,
+    });
+  } catch (error) {
+    const duplicate = await components
+      .knex('explorer_analysis')
+      .where({ id: input.id, project_id: project.id })
+      .first();
+    if (!duplicate || duplicate.request_hash !== requestHash) throw error;
+    return JSON.parse(duplicate.record);
+  }
+  const snapshots: string[] = [];
+  const update = () =>
+    components
+      .knex('explorer_analysis')
+      .where({ id: input.id, project_id: project.id })
+      .update({ status: record.status, record: JSON.stringify(record) });
+  const freeze = async (source: typeof loaded, id: string) => {
+    if (!serverConfig.dataOnlyMode) return;
+    const adapter = components.wrenEngineAdaptor as LocalDuckdbAdaptor;
+    source.base = await adapter.createExplorerSnapshot(
+      id,
+      source.base,
+      source.manifest,
+    );
+    snapshots.push(id);
+    source.query = async (sql) => {
+      const d = await adapter.queryDuckdb(sql);
+      return d.data.map((r) =>
+        Object.fromEntries(d.columns.map((c, i) => [c.name, r[i]])),
+      );
+    };
+  };
+  const readFull = async (
+    source: typeof loaded,
+    scope: typeof input,
+    count: number,
+  ) => {
+    if (count > Number(capability.maxMlRows))
+      throw new Error(
+        `ML analysis supports up to ${capability.maxMlRows.toLocaleString()} rows. This scope has ${count.toLocaleString()}. Narrow the scope or select another view; no preview sampling is used.`,
+      );
+    const rows = await source.query(
+      `SELECT * FROM (${filteredSQL(source.base, source.ctx, scope.filters)}) AS analysis_data`,
+      count + 1,
+    );
+    if (rows.length !== count)
+      throw new Error(
+        'Could not read the complete analysis population. No preview-only analysis was run.',
+      );
+    return rows;
+  };
+  try {
+    await freeze(loaded, snapshotId);
+    const frozen = await explorerService.profile(loaded, input.filters);
+    if (frozen.datasetVersion !== profile.datasetVersion)
+      throw new Error(
+        'Data changed while creating the snapshot. Reload setup.',
+      );
+    if (
+      (await explorerService.profile(loaded)).datasetVersion !==
+      input.sourceVersion
+    )
+      throw new Error(
+        'The source changed while creating its snapshot. Reload setup.',
+      );
+    if (testLoaded) {
+      await freeze(testLoaded, testSnapshot);
+      const frozenTest = await explorerService.profile(
+        testLoaded,
+        config.test.filters,
+      );
+      if (frozenTest.datasetVersion !== testProfile.datasetVersion)
+        throw new Error(
+          'Test data changed while creating its snapshot. Select it again.',
+        );
+      if (
+        config.test.sourceVersion &&
+        (await explorerService.profile(testLoaded)).datasetVersion !==
+          config.test.sourceVersion
+      )
+        throw new Error(
+          'The test source changed while creating its snapshot. Select it again.',
+        );
+    }
+    record.stage =
+      input.task === 'exploration'
+        ? 'Computing full-scope evidence'
+        : 'Running analysis service';
+    await update();
+    if (input.task === 'exploration') {
+      const charts = definitions.length
+        ? definitions
+        : explorerService.defaults(context, frozen);
+      const evidence = await Promise.all(
+        charts.map(async (chart) => ({
+          title: chart.title,
+          chart,
+          definition: `${chart.aggregation}(${chart.measure}) grouped by ${chart.groupBy}${chart.kind === 'time' ? ` / ${chart.timeGrain}` : ''}`,
+          ...(await explorerService.chart(loaded, input.filters, chart)),
+        })),
+      );
+      const result = await service('exploration', {
+        snapshotId,
+        goal: input.goal,
+        context,
+        profile: frozen,
+        evidence,
+        method: serverConfig.dataOnlyMode
+          ? 'Materialized full-view snapshot; filtered SQL aggregates'
+          : 'Frozen query-result aggregates; remote source is not a transactional snapshot',
+      });
+      const missing: ReportVisual = {
+        id: 'missingness',
+        title: 'Missing values by field',
+        kind: 'chartSpec',
+        caption: `Null counts across all ${frozen.rowCount.toLocaleString()} selected rows. No missing values have been imputed for this overview.`,
+        altText: 'Null counts for every field in the selected scope',
+        chartSpec: {
+          data: {
+            values: frozen.fields.map((f) => ({
+              label: f.name,
+              value: f.nullCount,
+            })),
+          },
+          mark: { type: 'bar', color: '#477dff' },
+          encoding: {
+            x: {
+              field: 'value',
+              type: 'quantitative',
+              title: 'Missing values',
+            },
+            y: { field: 'label', type: 'nominal', title: null },
+            tooltip: [{ field: 'label' }, { field: 'value' }],
+          },
+        },
+      };
+      Object.assign(record.report, {
+        summary: result.summary,
+        insights: result.insights,
+        visuals: [...evidence.map(evidenceVisual), missing],
+        findings: result.findings,
+        metrics: [
+          { label: 'Rows analysed', value: frozen.rowCount },
+          ...(frozen.metrics
+            ? [
+                {
+                  label: 'Distinct orders',
+                  value: frozen.metrics.distinctOrders,
+                },
+                {
+                  label: 'Item sales · price units',
+                  value: frozen.metrics.itemSales,
+                },
+              ]
+            : []),
+        ],
+        nextSteps: result.nextChecks,
+        limitations: result.limitations,
+      });
+    } else {
+      const data = await readFull(loaded, input, frozen.rowCount);
+      const testData = testLoaded
+        ? await readFull(
+            testLoaded,
+            { ...input, ...config.test },
+            testProfile.rowCount,
+          )
+        : undefined;
+      const result = await service('task', {
+        task: input.task,
+        goal: input.goal,
+        data,
+        testData,
+        fields: context.fields,
+        target: config.target,
+        features: config.features,
+        evaluation: config.evaluation || 'automatic',
+        split: config.split || 'auto',
+        groupColumn: config.groupColumn,
+        dateColumn: context.dateField,
+        clusters: config.clusters,
+        rowGrain: context.rowGrain,
+      });
+      Object.assign(record.report, result);
+    }
+    record.status = record.report.status = 'completed';
+    record.stage = 'Completed';
+  } catch (error) {
+    record.status = record.report.status = 'failed';
+    record.error = record.report.error =
+      error.message || 'Analysis could not be completed.';
+    record.stage = 'Failed';
+  } finally {
+    await update();
+    for (const id of snapshots)
+      await (components.wrenEngineAdaptor as LocalDuckdbAdaptor)
+        .dropExplorerSnapshot(id)
+        .catch((error) =>
+          console.error('Snapshot cleanup failed', id, error.message),
+        );
+  }
+  return record;
+}
