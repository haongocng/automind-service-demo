@@ -0,0 +1,53 @@
+import { useEffect, useState } from 'react';
+import { scopedRequest } from './scopedRequest';
+
+export async function explorerRequest<T>(
+  payload: unknown,
+  signal?: AbortSignal,
+): Promise<T> {
+  const response = await fetch('/api/explorer', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(payload),
+    signal,
+  });
+  const result = await response.json();
+  if (!response.ok) throw new Error(result.error || 'Request failed');
+  return result;
+}
+
+/** Scope-keyed resources never expose data from a previous dataset or filter. */
+export function useExplorerResource<T>(
+  payload: unknown,
+  delay = 0,
+  enabled = true,
+) {
+  const key = JSON.stringify(payload);
+  const [retry, setRetry] = useState(0);
+  const [state, setState] = useState<{ key: string; data?: T; error?: string }>(
+    { key: '' },
+  );
+  useEffect(() => {
+    if (!enabled) return;
+    let task: ReturnType<typeof scopedRequest<T>>;
+    setState({ key });
+    const timer = setTimeout(() => {
+      task = scopedRequest(
+        (signal) => explorerRequest<T>(JSON.parse(key), signal),
+        (data) => setState({ key, data }),
+        (error) => setState({ key, error: error.message }),
+      );
+    }, delay);
+    return () => {
+      task?.cancel();
+      clearTimeout(timer);
+    };
+  }, [key, retry, enabled, delay]);
+  const valid = state.key === key;
+  return {
+    data: valid ? state.data : undefined,
+    error: valid ? state.error : undefined,
+    loading: enabled && (!valid || (!state.data && !state.error)),
+    retry: () => setRetry((n) => n + 1),
+  };
+}
