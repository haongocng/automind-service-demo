diff --git a/wren-ui/src/utils/analysis/config.ts b/wren-ui/src/utils/analysis/config.ts
new file mode 100644
index 00000000..71fcf6aa
--- /dev/null
+++ b/wren-ui/src/utils/analysis/config.ts
@@ -0,0 +1,192 @@
+import { ExplorerContext, ExplorerProfile } from '../explorer/types';
+import { AnalysisDraft, AnalysisTask, RunInput } from './types';
+
+export const taskNames = {
+  exploration: 'Data exploration',
+  clustering: 'Clustering',
+  classification: 'Classification',
+  regression: 'Regression',
+};
+export const supervised = (task: AnalysisTask) =>
+  task === 'classification' || task === 'regression';
+export function suggestedGoal(
+  task: AnalysisTask,
+  ctx: ExplorerContext,
+  target?: string,
+) {
+  if (task === 'exploration')
+    return ctx.viewId === 'sales' &&
+      ctx.metricDefinitions.some((m) => m.includes('SUM(item_price)'))
+      ? 'Explore item sales over time and compare order volumes across customer states.'
+      : 'Summarize key patterns and data quality in the current view.';
+  if (task === 'clustering')
+    return 'Discover groups with similar characteristics and explain their differences.';
+  if (target)
+    return `Predict ${target} and ${task === 'classification' ? 'evaluate model performance' : 'explain the prediction errors'}.`;
+  return task === 'classification'
+    ? 'Predict the selected target class and evaluate model performance.'
+    : 'Predict the selected numeric target and explain the prediction errors.';
+}
+export function defaultDraft(
+  task: AnalysisTask,
+  ctx: ExplorerContext,
+): AnalysisDraft {
+  return {
+    task,
+    goal: suggestedGoal(task, ctx),
+    goalEditedByUser: false,
+    featureMode: 'auto',
+    features: [],
+    evaluation: 'automatic',
+    split: 'auto',
+    includeCharts: !!ctx.charts.length,
+  };
+}
+export function targetIssue(
+  target: string | undefined,
+  task: AnalysisTask,
+  ctx: ExplorerContext,
+  profile: ExplorerProfile,
+) {
+  if (!supervised(task)) return undefined;
+  if (!target) return 'Choose a target column to continue.';
+  const field = ctx.fields.find((f) => f.name === target);
+  if (!field) return 'Previously selected column is no longer available.';
+  if (['identifier', 'date', 'other'].includes(field.role))
+    return 'Identifiers, dates and unsupported fields cannot be prediction targets.';
+  const stats = profile.fields.find((f) => f.name === target);
+  if (!stats || stats.distinctCount < 2)
+    return 'The target needs at least two observed values.';
+  if (stats.nullCount)
+    return 'The target contains missing labels. Select a labelled scope before running.';
+  if (task === 'classification' && stats.distinctCount > 50)
+    return 'Classification requires 2–50 observed classes; choose a category rather than a continuous value.';
+  if (task === 'regression' && field.role !== 'number')
+    return 'Regression requires a numeric target.';
+  return undefined;
+}
+// A literal field immediately following an explicit predict/target instruction
+// is strong intent. A filename, position, or generic word "label" is not.
+export function explicitGoalTarget(goal: string, ctx: ExplorerContext) {
+  const instruction = goal
+    .match(/(?:predict|target(?:\s+column)?\s*[:=])\s+[`"']?(.+)/i)?.[1]
+    ?.toLowerCase();
+  if (!instruction) return undefined;
+  const matches = ctx.fields.filter((f) =>
+    [f.name, f.label].some((name) => {
+      const lower = name.toLowerCase();
+      return (
+        instruction.startsWith(lower) &&
+        !/[a-z0-9_]/.test(instruction.slice(lower.length, lower.length + 1))
+      );
+    }),
+  );
+  return matches.length === 1 ? matches[0].name : undefined;
+}
+export function resolveDraft(
+  draft: AnalysisDraft,
+  ctx: ExplorerContext,
+  profile: ExplorerProfile,
+): { draft: AnalysisDraft; issue?: string } {
+  const next = {
+    ...draft,
+    features: draft.features.filter((c) =>
+      ctx.fields.some((f) => f.name === c),
+    ),
+  };
+  if (!supervised(next.task)) return { draft: next };
+  const goalTarget = next.goalEditedByUser
+    ? explicitGoalTarget(next.goal, ctx)
+    : undefined;
+  if (
+    goalTarget &&
+    next.targetSource === 'manual' &&
+    next.target &&
+    goalTarget !== next.target
+  )
+    return {
+      draft: next,
+      issue: `Your goal specifies ${goalTarget}, but the selected target is ${next.target}. Change the target or edit the goal.`,
+    };
+  if (goalTarget && next.targetSource !== 'manual') {
+    next.target = goalTarget;
+    next.targetSource = 'goal';
+  }
+  if (!next.target) {
+    const candidates = ctx.fields.filter((f) =>
+      f.targetTasks?.includes(next.task as 'classification' | 'regression'),
+    );
+    if (candidates.length === 1) {
+      next.target = candidates[0].name;
+      next.targetSource = 'metadata';
+    }
+  }
+  if (!next.goalEditedByUser)
+    next.goal = suggestedGoal(next.task, ctx, next.target);
+  return {
+    draft: next,
+    issue: targetIssue(next.target, next.task, ctx, profile),
+  };
+}
+export function buildRun(
+  id: string,
+  ctx: ExplorerContext,
+  profile: ExplorerProfile,
+  draft: AnalysisDraft,
+): RunInput {
+  const base = {
+    id,
+    ref: {
+      projectId: ctx.projectId,
+      datasetId: ctx.datasetId,
+      viewId: ctx.viewId,
+      schemaVersion: ctx.schemaVersion,
+    },
+    filters: ctx.filters,
+    datasetVersion: profile.datasetVersion,
+    sourceVersion: profile.sourceVersion,
+    task: draft.task,
+    goal: draft.goal.trim(),
+  };
+  if (draft.task === 'exploration')
+    return {
+      ...base,
+      charts: draft.includeCharts ? ctx.charts : undefined,
+      config: { includeCharts: draft.includeCharts },
+    };
+  const features = draft.featureMode === 'select' ? draft.features : undefined;
+  if (draft.task === 'clustering')
+    return { ...base, config: { features, clusters: draft.clusters } };
+  return {
+    ...base,
+    config: {
+      target: draft.target,
+      features,
+      evaluation: draft.evaluation,
+      test: draft.evaluation === 'separate' ? draft.test : undefined,
+      split: draft.split,
+      groupColumn: draft.split === 'group' ? draft.groupColumn : undefined,
+    },
+  };
+}
+export function draftFromRun(
+  input: RunInput,
+  ctx: ExplorerContext,
+): AnalysisDraft {
+  const d = defaultDraft(input.task, ctx);
+  return {
+    ...d,
+    goal: input.goal,
+    goalEditedByUser: true,
+    target: input.config.target,
+    targetSource: input.config.target ? 'saved' : undefined,
+    featureMode: input.config.features ? 'select' : 'auto',
+    features: input.config.features || [],
+    evaluation: input.config.evaluation || 'automatic',
+    test: input.config.test,
+    split: input.config.split || 'auto',
+    groupColumn: input.config.groupColumn,
+    clusters: input.config.clusters,
+    includeCharts: input.config.includeCharts ?? true,
+  };
+}
