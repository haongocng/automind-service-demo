+export type FieldRole = 'date' | 'identifier' | 'number' | 'category' | 'other';
+export interface ExplorerField {
+  name: string;
+  label: string;
+  type: string;
+  role: FieldRole;
+  description?: string;
+  targetTasks?: ('classification' | 'regression')[];
+}
+export interface ExplorerFilters {
+  from?: string;
+  to?: string;
+  values?: Record<string, string>;
+}
+export interface ChartDefinition {
+  id: string;
+  title: string;
+  kind: 'time' | 'category' | 'distribution';
+  type: 'line' | 'area' | 'bar' | 'column' | 'table';
+  groupBy: string;
+  measure: string;
+  aggregation: 'count' | 'count_distinct' | 'sum' | 'avg' | 'min' | 'max';
+  timeGrain: 'day' | 'week' | 'month' | 'year';
+  categoryLimit: number;
+  useCurrentFilters: boolean;
+  invalidReason?: string;
+}
+export interface ExplorerRef {
+  projectId: number;
+  datasetId: string;
+  viewId: string;
+  schemaVersion: string;
+}
+export interface ExplorerContext extends ExplorerRef {
+  datasetName: string;
+  viewName: string;
+  sourceModelIds: number[];
+  modelCount: number;
+  fields: ExplorerField[];
+  rowGrain: string;
+  dateField?: string;
+  filterFields: string[];
+  metricDefinitions: string[];
+  defaultFilters: ExplorerFilters;
+  filters: ExplorerFilters;
+  charts: ChartDefinition[];
+  views: { id: string; name: string }[];
+}
+export interface ExplorerProfile {
+  sourceVersion?: string;
+  rowCount: number;
+  dateMin?: string;
+  dateMax?: string;
+  datasetVersion: string;
+  options: Record<string, string[]>;
+  fields: { name: string; nullCount: number; distinctCount: number }[];
+  metrics?: { itemSales: number | null; distinctOrders: number };
+}
+export interface ChartResult {
+  values: { label: string | number; value: number | null }[];
+  metricLabel: string;
+  scope: string;
+  sql?: string;
+}
+export interface AnalysisRecord {
+  id: string;
+  status: 'running' | 'completed' | 'failed';
+  createdAt: string;
+  goal: string;
+  context: ExplorerContext;
+  filters: ExplorerFilters;
+  snapshotId: string;
+  result?: {
+    summary: string[];
+    evidence: {
+      title: string;
+      definition: string;
+      values: ChartResult['values'];
+    }[];
+    insights?: {
+      id: string;
+      title: string;
+      detail: string;
+      evidenceIds: string[];
+    }[];
+    findings?: {
+      id: string;
+      title: string;
+      interpretation: string;
+      evidenceIds: string[];
+    }[];
+    limitations?: string[];
+    nextChecks: string[];
+    technical: Record<string, unknown>;
+  };
+  error?: string;
+}
